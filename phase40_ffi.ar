# المرحلة 40: استدعاء مكتبة math.h من C
# FFI — Foreign Function Interface

# حساب الجذر التربيعي
⎕ "sqrt(144) = "
⎕ نص(جذر(144))

# حساب قوة عدد
⎕ "pow(2, 10) = "
⎕ نص(قوة(2، 10))

# القيمة المطلقة
⎕ "abs(-42) = "
⎕ نص(مطلق(0 - 42))

# نظرية فيثاغورس: c = sqrt(a² + b²)
⎕ "مثلث 3-4-5:"
أ ≔ 3
ب ≔ 4
وتر ≔ جذر(أ · أ + ب · ب)
⎕ نص(وتر)