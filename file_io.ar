تخزين ≔ λ(ملف, مفتاح, قيمة).
    ﴿
    اكتب_ملف(ملف, مفتاح + ":" + قيمة + "\n")
    ﴾

استرجاع ≔ λ(ملف, مفتاح).
    ﴿
    محتوى ≔ اقرأ_ملف(ملف, 4096)
    i ≔ 0
    طول_محتوى ≔ طول(محتوى)
    مفتاح_مع_فاصل ≔ مفتاح + ":"
    طول_مفتاح ≔ طول(مفتاح_مع_فاصل)
    نتيجة ≔ ""
    μ i < طول_محتوى : ﴿
        سطر ≔ ""
        μ i < طول_محتوى ∧ حرف_محتوى(محتوى, i) ≠ "\n" : ﴿
            سطر ≔ سطر + حرف_محتوى(محتوى, i)
            i ≔ i + 1
        ﴾
        μ طول(سطر) ≥ طول_مفتاح ∧ سطر[0:طول_مفتاح] = مفتاح_مع_فاصل : ﴿
            نتيجة ≔ سطر[طول_مفتاح:طول(سطر)]
        ﴾
        i ≔ i + 1
    ﴾
    return نتيجة
    ﴾

⎕ "file_io.ar OK"
