# تنفيذ SHA-256 في MAL
# يعتمد على العمليات البتية والحلقات μ

# الدوال المساعدة (عمليات 32-بت)
rotr ≔ λ(x, n). (x إز_يمين n) أو_بتي (x إز_يسار (32 - n))

ch ≔ λ(x, y, z). (x و_بتي y) نفي_ثنائي ((x نفي_ثنائي 4294967295) و_بتي z)

maj ≔ λ(x, y, z). (x و_بتي y) نفي_ثنائي (x و_بتي z) نفي_ثنائي (y و_بتي z)

sig0 ≔ λ(x). rotr(x, 2) نفي_ثنائي rotr(x, 13) نفي_ثنائي rotr(x, 22)

sig1 ≔ λ(x). rotr(x, 6) نفي_ثنائي rotr(x, 11) نفي_ثنائي rotr(x, 25)

ksig0 ≔ λ(x). rotr(x, 7) نفي_ثنائي rotr(x, 18) نفي_ثنائي (x إز_يمين 3)

ksig1 ≔ λ(x). rotr(x, 17) نفي_ثنائي rotr(x, 19) نفي_ثنائي (x إز_يمين 10)

# تحويل رقم إلى نص سداسي عشري (32-بت)
hex32 ≔ λ(x).
    ﴿
    s ≔ ""
    i ≔ 3
    μ i >= 0 : ﴿
        b ≔ (x إز_يمين (8 * i)) و_بتي 255
        d1 ≔ b إز_يمين 4
        s ≔ s + نص_رمز(d1 + 48 if d1 < 10 else d1 + 87)
        d2 ≔ b و_بتي 15
        s ≔ s + نص_رمز(d2 + 48 if d2 < 10 else d2 + 87)
        i ≔ i - 1
    ﴾
    return s
    ﴾

# دالة SHA-256 (نسخة مبسطة للاختبار)
