// Arabic Autoregressive Generation in MAL
let VOCAB: [i32; 4] = [1605, 1575, 1604, 10];
let W_ar: [f32; 16] = [10.0, 0.0, 0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 0.0, 0.0, 10.0];
fn get_char_code(token_id: i32) -> i32 {
    if token_id >= 0 && token_id < 4 { return VOCAB[token_id]; }
    return 32;
}
fn predict_next_token(step: i32) -> i32 {
    let mut max_logit: f32 = -9999.0;
    let mut best_token: i32 = 0;
    let mut i: i32 = 0;
    while i < 4 {
        let logit: f32 = W_ar[step * 4 + i];
        if logit > max_logit {
            max_logit = logit;
            best_token = i;
        }
        i = i + 1;
    }
    return best_token;
}
fn main() -> i32 {
    printf("=== Arabic Autoregressive Generation Test ===\n\n");
    printf("Prompt: ");
    let mut step: i32 = 0;
    while step < 4 {
        let next_token: i32 = predict_next_token(step);
        let current_char: i32 = get_char_code(next_token);
        printf("%c", current_char);
        step = step + 1;
    }
    printf("\n✅ Arabic generation completed successfully!\n");
    return 0;
}
