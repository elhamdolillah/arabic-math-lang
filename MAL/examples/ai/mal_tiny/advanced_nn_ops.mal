let B_lin: [f32; 8] = [-0.002389, -0.009076, -0.005768, 0.007554, 0.005009, -0.009776, 0.000993, 0.007514];

fn main() -> i32 {
    let mut x: [f32; 64] = [1.0; 64];
    let mut logits: [f32; 8] = [0.0; 8];
    let mut norm_out: [f32; 8] = [0.0; 8];
    let mut softmax_out: [f32; 8] = [0.0; 8];
    let mut i: i32 = 0;
    let mut j: i32 = 0;
    let mut sum: f32 = 0.0;

    // 1. الطبقة الخطية (Linear Projection)
    i = 0;
    while i < 8 {
        sum = 0.0;
        j = 0;
        #unroll
        while j < 64 {
            sum = sum + (W_lin[i * 64 + j] * x[j]);
            j = j + 1;
        }
        logits[i] = sum + B_lin[i];
        i = i + 1;
    }

    // 2. تطبيع الطبقة (Layer Normalization)
    sum = 0.0;
    i = 0;
    while i < 8 { sum = sum + logits[i]; i = i + 1; }
    let mut mean: f32 = sum / 8.0;
    let mut variance: f32 = 0.0;
    i = 0;
    while i < 8 {
        let mut diff: f32 = logits[i] - mean;
        variance = variance + (diff * diff);
        i = i + 1;
    }
    variance = variance / 8.0;
    let mut inv_std: f32 = 1.0 / sqrtf(variance + 0.00001);
    i = 0;
    while i < 8 {
        norm_out[i] = (logits[i] - mean) * inv_std;
        i = i + 1;
    }

    // 3. دالة التنشيط الاحتمالي (Softmax مع استقرار رقمي)
    let mut max_val: f32 = -9999.0;
    i = 0;
    while i < 8 {
        if norm_out[i] > max_val { max_val = norm_out[i]; }
        i = i + 1;
    }
    sum = 0.0;
    i = 0;
    while i < 8 {
        let mut exp_val: f32 = expf(norm_out[i] - max_val);
        softmax_out[i] = exp_val;
        sum = sum + exp_val;
        i = i + 1;
    }
    i = 0;
    while i < 8 {
        softmax_out[i] = softmax_out[i] / sum;
        i = i + 1;
    }

    printf("✅ تم إكمال الاستدلال المتقدم بنجاح!\n");
    printf("📊 مخرجات Softmax النهائية (يجب أن مجموعها = 1.0):\n");
    i = 0;
    while i < 8 {
        printf("  الفئة %d: %.6f\n", i, softmax_out[i]);
        i = i + 1;
    }
    return 0;
}