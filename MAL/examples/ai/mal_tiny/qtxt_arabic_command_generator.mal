// ============================================================
// مولد أوامر qtxt من الأوامر العربية باستخدام محرك الاشتقاق
// ============================================================
// دالة مطابقة الأمر العربي المدخل (كمصفوفة UTF-16)
fn match_arabic_command(input: &[i32], len: i32) -> i32 {
    // مطابقة "اعرض" (أ + ع + ر + ض) -> 0x0623, 0x0639, 0x0631, 0x0636
    if len == 4 {
        if input[0] == 0x0623 && input[1] == 0x0639 && input[2] == 0x0631 && input[3] == 0x0636 {
            return 1; // أمر العرض
        }
    }
    // مطابقة "اكتب" (أ + ك + ت + ب) -> 0x0623, 0x0643, 0x062A, 0x0628
    if len == 4 {
        if input[0] == 0x0623 && input[1] == 0x0643 && input[2] == 0x062A && input[3] == 0x0628 {
            return 2; // أمر الكتابة
        }
    }
    return 0; // غير معروف
}
// دالة توليد أمر qtxt المقابل بناءً على المعرف
fn generate_qtxt_command(cmd_id: i32) {
    if cmd_id == 1 {
        printf("========== COMMANDS TO EXECUTE ==========\n");
        printf("     1  cd /root/ilm-al-kitab/MAL\n");
        printf("     2  ls -la\n");
        printf("=========================================\n");
    } else {
        if cmd_id == 2 {
            printf("========== COMMANDS TO EXECUTE ==========\n");
            printf("     1  cd /root/ilm-al-kitab/MAL\n");
            printf("     2  echo 'Hello MAL' > test.txt\n");
            printf("=========================================\n");
        } else {
            printf("❌ الأمر غير معروف في قاموس MAL\n");
        }
    }
}
fn main() -> i32 {
    printf("=== Arabic to qtxt Command Generator ===\n\n");
    // اختبار 1: "اعرض"
    let cmd1: [i32; 4] = [0x0623, 0x0639, 0x0631, 0x0636];
    printf("Input: 'اعرض' (Show)\n");
    let id1: i32 = match_arabic_command(cmd1, 4);
    printf("Generated qtxt:\n");
    generate_qtxt_command(id1);
    printf("\n");
    // اختبار 2: "اكتب"
    let cmd2: [i32; 4] = [0x0623, 0x0643, 0x062A, 0x0628];
    printf("Input: 'اكتب' (Write)\n");
    let id2: i32 = match_arabic_command(cmd2, 4);
    printf("Generated qtxt:\n");
    generate_qtxt_command(id2);
    printf("\n");
    // اختبار 3: أمر غير معروف
    let cmd3: [i32; 4] = [0x0634, 0x063A, 0x0644, 0x0020];
    printf("Input: 'شغل ' (Run - unknown pattern)\n");
    let id3: i32 = match_arabic_command(cmd3, 4);
    printf("Generated qtxt:\n");
    generate_qtxt_command(id3);
    return 0;
}
