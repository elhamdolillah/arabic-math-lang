// ============================================================
// Grammatical Type Checker in MAL
// ينفذ فحص الأنواع النحوية (Grammatical Type Checking) للتأكد من صحة التركيب
// ============================================================
// 1. تعريف أنواع الكلمات (Word Types)
let TYPE_HARF_JAR: i32 = 1;    // حرف جر
let TYPE_ISM: i32 = 2;         // اسم
let TYPE_HARF_NASIKH: i32 = 3; // حرف ناسخ (إنّ وأخواتها)
// 2. تعريف حالات الإعراب (Grammatical Cases)
let CASE_MARFU: i32 = 1;       // مرفوع
let CASE_MANSUB: i32 = 2;      // منصوب
let CASE_MAJRUR: i32 = 3;      // مجرور
// 3. دالة فحص قاعدة "الجر والمجرور"
// تتحقق من أن أي اسم يلي حرف جر يجب أن يكون مجروراً
fn check_jar_wa_majrur(types: &[i32], cases: &[i32], len: i32) -> i32 {
    let mut i: i32 = 0;
    while i < len - 1 {
        if types[i] == TYPE_HARF_JAR {
            if types[i + 1] == TYPE_ISM {
                if cases[i + 1] != CASE_MAJRUR {
                    return 0; // خطأ نحوي: انتهاك قيد السياق
                }
            }
        }
        i = i + 1;
    }
    return 1; // صحيح نحويًا
}
// 4. دالة فحص قاعدة "إنّ وأخواتها"
// تتحقق من أن الاسم بعد إنّ منصوب، والخبر مرفوع
fn check_inna_wa_akhawatuha(types: &[i32], cases: &[i32], len: i32) -> i32 {
    if len >= 3 {
        if types[0] == TYPE_HARF_NASIKH {
            if cases[1] != CASE_MANSUB {
                return 0; // خطأ: اسم إنّ يجب أن يكون منصوباً
            }
            if cases[2] != CASE_MARFU {
                return 0; // خطأ: خبر إنّ يجب أن يكون مرفوعاً
            }
            return 1;
        }
    }
    return 0;
}
// دالة مساعدة لطباعة نتيجة الفحص
fn print_result(is_valid: i32) {
    if is_valid == 1 {
        printf("  Result: ✅ VALID (قاعدة نحوية صحيحة)\n\n");
    } else {
        printf("  Result: ❌ GRAMMAR ERROR (انتهاك قاعدة نحوية)\n\n");
    }
}
fn main() -> i32 {
    printf("=== Grammatical Type Checker in MAL ===\n\n");
    // ==========================================
    // اختبار 1: قاعدة الجر والمجرور (صحيحة)
    // الجملة: "في المدرسةِ" -> أنواع: [حرف جر, اسم], إعراب: [غير منطبق, مجرور]
    // ==========================================
    printf("Test 1: 'في المدرسةِ' (Jar wa Majrur - Valid)\n");
    let types1: [i32; 2] = [1, 2];
    let cases1: [i32; 2] = [0, 3];
    let res1: i32 = check_jar_wa_majrur(types1, cases1, 2);
    print_result(res1);
    // ==========================================
    // اختبار 2: قاعدة الجر والمجرور (خاطئة)
    // الجملة: "في المدرسةُ" -> إعراب: [غير منطبق, مرفوع] <- خطأ!
    // ==========================================
    printf("Test 2: 'في المدرسةُ' (Jar wa Majrur - Invalid)\n");
    let types2: [i32; 2] = [1, 2];
    let cases2: [i32; 2] = [0, 1];
    let res2: i32 = check_jar_wa_majrur(types2, cases2, 2);
    print_result(res2);
    // ==========================================
    // اختبار 3: قاعدة إنّ وأخواتها (صحيحة)
    // الجملة: "إنّ العلمَ نورٌ" -> أنواع: [ناسخ, اسم, خبر], إعراب: [0, منصوب, مرفوع]
    // ==========================================
    printf("Test 3: 'إنّ العلمَ نورٌ' (Inna - Valid)\n");
    let types3: [i32; 3] = [3, 2, 2];
    let cases3: [i32; 3] = [0, 2, 1];
    let res3: i32 = check_inna_wa_akhawatuha(types3, cases3, 3);
    print_result(res3);
    // ==========================================
    // اختبار 4: قاعدة إنّ وأخواتها (خاطئة)
    // الجملة: "إنّ العلمُ نورٌ" -> إعراب: [0, مرفوع, مرفوع] <- خطأ!
    // ==========================================
    printf("Test 4: 'إنّ العلمُ نورٌ' (Inna - Invalid)\n");
    let types4: [i32; 3] = [3, 2, 2];
    let cases4: [i32; 3] = [0, 1, 1];
    let res4: i32 = check_inna_wa_akhawatuha(types4, cases4, 3);
    print_result(res4);
    printf("==========================================\n");
    printf("Conclusion:\n");
    printf("- MAL hosts a deterministic Grammatical Type Checker.\n");
    printf("- Syntax rules are enforced as strict logical constraints.\n");
    printf("- Arabic grammar is proven to be a computable formal system.\n");
    printf("==========================================\n");
    return 0;
}
