let B_ff2: [f32; 16] = [-0.002232, 0.014899, -0.016009, -0.008285, -0.001033, -0.016432, -0.001759, 0.016615, 0.000209, 0.002307, -0.012602, -0.006164, -0.003752, -0.003177, 0.012816, 0.005577];

fn main() -> i32 {
    let mut x: [f32; 64] = [1.0; 64];
    let mut x_norm: [f32; 64] = [0.0; 64];
    let mut q: [f32; 64] = [0.0; 64];
    let mut k: [f32; 64] = [0.0; 64];
    let mut v: [f32; 64] = [0.0; 64];
    let mut attn_out: [f32; 64] = [0.0; 64];
    let mut ff_hidden: [f32; 128] = [0.0; 128];
    let mut ff_out: [f32; 64] = [0.0; 64];
    let mut i: i32 = 0;
    let mut j: i32 = 0;
    let mut d: i32 = 0;
    let mut h: i32 = 0;
    let mut sum: f32 = 0.0;
    let mut mean: f32 = 0.0;
    let mut variance: f32 = 0.0;
    let mut inv_std: f32 = 0.0;
    let mut max_val: f32 = 0.0;
    let mut diff: f32 = 0.0;
    let mut val: f32 = 0.0;

    // 1. Pre-LayerNorm
    i = 0;
    while i < 4 {
        sum = 0.0;
        d = 0;
        while d < 16 { sum = sum + x[i * 16 + d]; d = d + 1; }
        mean = sum / 16.0;
        variance = 0.0;
        d = 0;
        while d < 16 {
            diff = x[i * 16 + d] - mean;
            variance = variance + (diff * diff);
            d = d + 1;
        }
        variance = variance / 16.0;
        inv_std = 1.0 / sqrtf(variance + 0.00001);
        d = 0;
        while d < 16 { x_norm[i * 16 + d] = (x[i * 16 + d] - mean) * inv_std; d = d + 1; }
        i = i + 1;
    }

    // 2. Q Projection
    i = 0;
    while i < 4 {
        d = 0;
        while d < 16 {
            sum = 0.0;
            j = 0;
            #unroll
            while j < 16 {
                sum = sum + (W_q[d * 16 + j] * x_norm[i * 16 + j]);
                j = j + 1;
            }
            q[i * 16 + d] = sum + B_q[d];
            d = d + 1;
        }
        i = i + 1;
    }

    // 2. K Projection
    i = 0;
    while i < 4 {
        d = 0;
        while d < 16 {
            sum = 0.0;
            j = 0;
            #unroll
            while j < 16 {
                sum = sum + (W_k[d * 16 + j] * x_norm[i * 16 + j]);
                j = j + 1;
            }
            k[i * 16 + d] = sum + B_k[d];
            d = d + 1;
        }
        i = i + 1;
    }

    // 2. V Projection
    i = 0;
    while i < 4 {
        d = 0;
        while d < 16 {
            sum = 0.0;
            j = 0;
            #unroll
            while j < 16 {
                sum = sum + (W_v[d * 16 + j] * x_norm[i * 16 + j]);
                j = j + 1;
            }
            v[i * 16 + d] = sum + B_v[d];
            d = d + 1;
        }
        i = i + 1;
    }

    // 3. Multi-Head Self-Attention
    i = 0;
    while i < 64 { attn_out[i] = 0.0; i = i + 1; }
    h = 0;
    while h < 2 {
        i = 0;
        while i < 4 {
            let mut scores: [f32; 4] = [0.0; 4];
            max_val = -9999.0;
            j = 0;
            while j < 4 {
                sum = 0.0;
                d = 0;
                while d < 8 {
                    sum = sum + (q[i * 16 + h * 8 + d] * k[j * 16 + h * 8 + d]);
                    d = d + 1;
                }
                scores[j] = sum * 0.3535;
                if scores[j] > max_val { max_val = scores[j]; }
                j = j + 1;
            }
            sum = 0.0;
            j = 0;
            while j < 4 {
                scores[j] = expf(scores[j] - max_val);
                sum = sum + scores[j];
                j = j + 1;
            }
            j = 0;
            while j < 4 { scores[j] = scores[j] / sum; j = j + 1; }
            d = 0;
            while d < 8 {
                sum = 0.0;
                j = 0;
                while j < 4 {
                    sum = sum + (scores[j] * v[j * 16 + h * 8 + d]);
                    j = j + 1;
                }
                attn_out[i * 16 + h * 8 + d] = sum;
                d = d + 1;
            }
            i = i + 1;
        }
        h = h + 1;
    }

    // 4. Output Projection & Residual Connection
    i = 0;
    while i < 4 {
        d = 0;
        while d < 16 {
            sum = 0.0;
            j = 0;
            #unroll
            while j < 16 {
                sum = sum + (W_o[d * 16 + j] * attn_out[i * 16 + j]);
                j = j + 1;
            }
            x[i * 16 + d] = x[i * 16 + d] + sum + B_o[d];
            d = d + 1;
        }
        i = i + 1;
    }

    // 5. Post-LayerNorm
    i = 0;
    while i < 4 {
        sum = 0.0;
        d = 0;
        while d < 16 { sum = sum + x[i * 16 + d]; d = d + 1; }
        mean = sum / 16.0;
        variance = 0.0;
        d = 0;
        while d < 16 {
            diff = x[i * 16 + d] - mean;
            variance = variance + (diff * diff);
            d = d + 1;
        }
        variance = variance / 16.0;
        inv_std = 1.0 / sqrtf(variance + 0.00001);
        d = 0;
        while d < 16 { x_norm[i * 16 + d] = (x[i * 16 + d] - mean) * inv_std; d = d + 1; }
        i = i + 1;
    }

    // 6. Feed-Forward Network (ReLU)
    i = 0;
    while i < 4 {
        d = 0;
        while d < 32 {
            sum = 0.0;
            j = 0;
            #unroll
            while j < 16 {
                sum = sum + (W_ff1[j * 32 + d] * x_norm[i * 16 + j]);
                j = j + 1;
            }
            val = sum + B_ff1[d];
            if val > 0.0 {
                ff_hidden[i * 32 + d] = val;
            } else {
                ff_hidden[i * 32 + d] = 0.0;
            }
            d = d + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < 4 {
        d = 0;
        while d < 16 {
            sum = 0.0;
            j = 0;
            #unroll
            while j < 32 {
                sum = sum + (W_ff2[j * 16 + d] * ff_hidden[i * 32 + j]);
                j = j + 1;
            }
            ff_out[i * 16 + d] = sum + B_ff2[d];
            d = d + 1;
        }
        i = i + 1;
    }

    // 7. Final Residual Connection
    i = 0;
    while i < 64 {
        x[i] = x[i] + ff_out[i];
        i = i + 1;
    }

    printf("✅ تم إكمال تمرير Multi-Head Transformer بنجاح!\n");
    printf("📊 مخرج الرمز (Token) الأول، البعد الأول: %f\n", x[0]);
    printf("📊 مخرج الرمز (Token) الأول، البعد الثاني: %f\n", x[1]);
    return 0;
}