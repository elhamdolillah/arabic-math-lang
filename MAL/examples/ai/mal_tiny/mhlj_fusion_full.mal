        while j < 64 {
            sum = sum + (W_r0[i * 64 + j] * h4[j]);
            j = j + 1;
        }
        let val: f32 = sum + B_r0[i];
        if val > 0.0 { h5[i] = val; } else { h5[i] = 0.0; }
        i = i + 1;
    }
    // 7. طبقة jev_router 2 (128 -> 64)
    let mut h6: [f32; 8] = [0.0; 8];
    i = 0;
    while i < 8 {
        let mut sum: f32 = 0.0;
        let mut j: i32 = 0;
        while j < 128 {
            sum = sum + (W_r2[i * 128 + j] * h5[j]);
            j = j + 1;
        }
        h6[i] = sum + B_r2[i];
        i = i + 1;
    }

    printf("📊 مخرجات التصنيف النهائية (8 فئات):\n");
    i = 0;
    while i < 8 {
        printf("  الفئة %d: %f\n", i, h6[i]);
        i = i + 1;
    }
    printf("⚡ تم الاستدلال الكامل بنجاح باستخدام كل الأوزان الحقيقية!\n");
    return 0;
}