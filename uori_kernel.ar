تحليل_نية ≔ λ(نص).
    ﴿
    نتيجة ≔ "غير_معروف"
    μ نص = "تنفيذ" : ﴿ نتيجة ≔ "تنفيذ" ﴾
    μ نص = "رفض" : ﴿ نتيجة ≔ "رفض" ﴾
    μ نص = "امتناع" : ﴿ نتيجة ≔ "امتناع" ﴾
    μ نص = "استعلام" : ﴿ نتيجة ≔ "استعلام" ﴾
    return نتيجة
    ﴾

ميزانية_موارد ≔ λ(خطة).
    ﴿
    عداد ≔ 0
    i ≔ 0
    μ i < طول(خطة) : ﴿
        حرف ≔ حرف_محتوى(خطة, i)
        μ حرف = "+" ∨ حرف = "-" ∨ حرف = "*" ∨ حرف = "/" ∨ حرف = "%" ∨ حرف = "^" : ﴿
            عداد ≔ عداد + 1
        ﴾
        i ≔ i + 1
    ﴾
    return عداد
    ﴾

سلامة_خطة ≔ λ(خطة).
    ﴿
    # بدون SHA-256، نعيد طول الخطة كبصمة مؤقتة
    return طول(خطة)
    ﴾

⎕ "uori_kernel.ar OK"
