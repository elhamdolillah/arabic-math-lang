# المرحلة 42: Generics — الأنواع المعممة
# دوال تعمل مع أي نوع (Parametric Polymorphism)

# ─── مثال 1: دالة المطابقة ───
⎕ "=== identity ==="
مطابقة ≡ λس. س
⎕ نص(مطابقة(42))
⎕ مطابقة("مرحبا")

# ─── مثال 2: دالة التبديل ───
⎕ "=== swap ==="
تبديل ≡ λ(أ، ب). ⟨ب، أ⟩
ق ≔ تبديل(10، 20)
⎕ نص(رأس(ق))
⎕ نص(رأس(ذيل(ق)))

# ─── مثال 3: map — طبّق دالة على قائمة ───
⎕ "=== map ==="
طبّق ≡ λ(د، ق). ﴿
    ن ≔ ⟨⟩
    ⋄ ∀ ع ∈ ق : ﴿ ن ≔ ألحق(ن، د(ع)) ﴾
    ⋄ ن
﴾
مربع ≡ λس. س · س
مربعات ≔ طبّق(مربع، ⟨1، 2، 3، 4⟩)
⎕ "sum of squares: "
⎕ نص(مجموع_قائمة(مربعات))

# ─── مثال 4: fold — اختزل قائمة ───
⎕ "=== fold ==="
اطوِ ≡ λ(د، بداية، ق). ﴿
    ن ≔ بداية
    ⋄ ∀ ع ∈ ق : ﴿ ن ≔ د(ن، ع) ﴾
    ⋄ ن
﴾
جمع ≡ λ(أ، ب). أ + ب
ن ≔ اطوِ(جمع، 0، ⟨1، 2، 3، 4، 5⟩)
⎕ "sum 1..5 = "
⎕ نص(ن)