# المرحلة 42: Generics — Parametric Polymorphism
⎕ "=== Identity ==="
مطابقة ≡ λس. س
⎕ نص(مطابقة(42))
⎕ مطابقة("مرحبا")

⎕ "=== Swap ==="
تبديل ≡ λ(أ، ب). ⟨ب، أ⟩
ق ≔ تبديل(10، 20)
⎕ نص(رأس(ق))
⎕ نص(رأس(ذيل(ق)))

⎕ "=== Index ==="
أعداد ≔ ⟨10، 20، 30، 40، 50⟩
⎕ نص(أعداد[2])

⎕ "=== Map ==="
طبّق ≡ λ(د، ق). ﴿
    ن ≔ ⟨⟩
    ⋄ ∀ ع ∈ ق : ﴿ ن ≔ ألحق(ن، د(ع)) ﴾
    ⋄ ن
﴾
مربع ≡ λس. س · س
ن ≔ طبّق(مربع، ⟨1، 2، 3، 4⟩)
⎕ نص(مجموع_قائمة(ن))

⎕ "=== Fold ==="
اطوِ ≡ λ(د، بداية، ق). ﴿
    ن ≔ بداية
    ⋄ ∀ ع ∈ ق : ﴿ ن ≔ د(ن، ع) ﴾
    ⋄ ن
﴾
جمع ≡ λ(أ، ب). أ + ب
مجموع ≔ اطوِ(جمع، 0، ⟨1، 2، 3، 4، 5⟩)
⎕ نص(مجموع)