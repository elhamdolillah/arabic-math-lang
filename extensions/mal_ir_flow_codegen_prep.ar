إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-IR-FLOW-CODEGEN-PREP"

حد_السعة ≔ 8
ممتنع ≔ "ABSTAIN"
مقبول ≔ "PASS"
تهيئة ≔ "CODEGEN_PREPARED"

عملية_ثابت ≔ "ثابت"
عملية_نص ≔ "تحميل_نص"
عملية_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"

عملية_مسموحة ≡ λعملية.
  عملية ≔ عملية_ثابت ∨ عملية ≔ عملية_نص ∨ عملية ≔ عملية_حقيقي ∨
  عملية ≔ عملية_نداء ∨ عملية ≔ عملية_مجموعة

فهرس_صحيح ≡ λقيمة. قيمة ≥ 1 ∧ قيمة ≤ حد_السعة
ترتيب_صحيح ≡ λحالي. λسابق. حالي > سابق
رمز_توليد ≡ λعملية. λالعقدة. λالرتبة.
  "gen_" ⧺ العملية ⧺ "_" ⧺ نص(العقدة) ⧺ "_" ⧺ نص(الرتبة)

إضافة_تدفق ≡ λالسجل. λالعقدة. λالرتبة. λالعملية. λالسابق.
  (فهرس_صحيح(السجل) ∧ فهرس_صحيح(العقدة) ∧ فهرس_صحيح(الرتبة) ∧
   ترتيب_صحيح(السجل)(السابق) ∧ عملية_مسموحة(العملية)) ?
   ⟨مقبول, السجل, العقدة, الرتبة, العملية, رمز_توليد(العملية)(العقدة)(الرتبة), تهيئة⟩ :
   ⟨ممتنع, 0, 0, 0, "", "", "CODEGEN_BLOCKED"⟩

تدفق_01 ≔ إضافة_تدفق(1)(1)(1)(عملية_ثابت)(0)
تدفق_02 ≔ إضافة_تدفق(2)(2)(2)(عملية_نص)(1)
تدفق_03 ≔ إضافة_تدفق(3)(3)(3)(عملية_حقيقي)(2)
تدفق_04 ≔ إضافة_تدفق(4)(4)(4)(عملية_نداء)(3)
تدفق_05 ≔ إضافة_تدفق(5)(5)(5)(عملية_مجموعة)(4)
تدفق_رفض_عملية ≔ إضافة_تدفق(6)(6)(6)("ممنوعة")(5)
تدفق_رفض_رتبة ≔ إضافة_تدفق(5)(7)(7)(عملية_نداء)(6)
تدفق_رفض_سعة ≔ إضافة_تدفق(9)(8)(8)(عملية_ثابت)(5)

