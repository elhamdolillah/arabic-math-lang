إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-IR-INSTRUCTION-LEDGER"

رقم_فارغ ≔ 0
حد_السجل ≔ 8

عملية_ثابت ≔ "ثابت"
عملية_تحميل_نص ≔ "تحميل_نص"
عملية_تحميل_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"
عملية_ممنوعة ≔ "ممنوعة"

تحقق_الرقم ≡ λالرقم. الرقم ≥ 1 ∧ الرقم ≤ حد_السجل
تحقق_الرتبة ≡ λالرتبة. الرتبة ≥ 1 ∧ الرتبة ≤ حد_السجل
تحقق_المعرف ≡ λالمعرف. المعرف ≥ 1 ∧ المعرف ≤ حد_السجل

تحقق_العملية ≡ λالعملية.
  العملية ≔ عملية_ثابت ∨ العملية ≔ عملية_تحميل_نص ∨
  العملية ≔ عملية_تحميل_حقيقي ∨ العملية ≔ عملية_نداء ∨ العملية ≔ عملية_مجموعة

رمز_العملية ≡ λالعملية.
  تحقق_العملية(العملية) ? "ir_" ⧺ العملية : ""

إضافة_سجل ≡ λالرقم. λالعملية. λالمعرف. λالرتبة. λالسابق.
  (تحقق_الرقم(الرقم) ∧ تحقق_العملية(العملية) ∧ تحقق_المعرف(المعرف) ∧
   تحقق_الرتبة(الرتبة) ∧ الرقم > السابق) ?
    ⟨"PASS", الرقم, العملية, المعرف, الرتبة, رمز_العملية(العملية), "IR_LEDGER_ACCEPTED"⟩ :
    ⟨"ABSTAIN", رقم_فارغ, عملية_ممنوعة, رقم_فارغ, 0, "", "IR_LEDGER_REJECTED"⟩

سجل_ثابت ≔ إضافة_سجل(1)(عملية_ثابت)(1)(1)(0)
سجل_نص ≔ إضافة_سجل(2)(عملية_تحميل_نص)(2)(2)(1)
سجل_حقيقي ≔ إضافة_سجل(3)(عملية_تحميل_حقيقي)(3)(3)(2)
سجل_نداء ≔ إضافة_سجل(4)(عملية_نداء)(4)(4)(3)
سجل_مجموعة ≔ إضافة_سجل(5)(عملية_مجموعة)(5)(5)(4)

سجل_عملية_مجهولة ≔ إضافة_سجل(6)("مجهولة")(6)(6)(5)
سجل_رقم_خارج_الحد ≔ إضافة_سجل(9)(عملية_ثابت)(7)(7)(6)
سجل_معرف_مكرر ≔ إضافة_سجل(6)(عملية_نداء)(5)(6)(5)
سجل_رتبة_صفر ≔ إضافة_سجل(7)(عملية_مجموعة)(7)(0)(6)

