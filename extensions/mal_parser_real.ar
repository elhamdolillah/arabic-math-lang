إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-PARSER-REAL"

رمز_حقيقي ≔ "حقيقي"
نوع_حقيقي ≔ 5
علم_صالح ≔ 1
علم_مرفوض ≔ 0

تحقق_الفهرس ≡ λالفهرس. الفهرس > -1
تحقق_النهائية ≡ λعلم. علم = علم_صالح
تحقق_التطبيع ≡ λعلم. علم = علم_صالح

عقدة_حقيقي ≡ λالقيمة. ⟨نوع_حقيقي, القيمة, 0, 0, 0⟩

حلل_حقيقي_آمن ≡ λالرمز.
  (الرمز[0] = رمز_حقيقي ∧
   تحقق_الفهرس(الرمز[1]) ∧
   تحقق_النهائية(الرمز[2]) ∧
   تحقق_التطبيع(الرمز[3])) ?
    ⟨"PASS", عقدة_حقيقي(الرمز[1]), 1, "NONE"⟩ :
    ⟨"ABSTAIN", 0, 0,
      (الرمز[0] ≠ رمز_حقيقي ? "UNKNOWN_TOKEN_KIND" :
       (¬تحقق_الفهرس(الرمز[1]) ? "INVALID_VALUE_ID" :
        (¬تحقق_النهائية(الرمز[2]) ? "NON_FINITE" : "NON_CANONICAL_REAL")))⟩

نتيجة_اختبار_موجب ≔ حلل_حقيقي_آمن(⟨رمز_حقيقي, 12, علم_صالح, علم_صالح⟩)
نتيجة_اختبار_نان ≔ حلل_حقيقي_آمن(⟨رمز_حقيقي, 13, علم_مرفوض, علم_صالح⟩)
نتيجة_اختبار_لا_نهائي ≔ حلل_حقيقي_آمن(⟨رمز_حقيقي, 14, علم_صالح, علم_مرفوض⟩)
نتيجة_اختبار_فهرس ≔ حلل_حقيقي_آمن(⟨رمز_حقيقي, -1, علم_صالح, علم_صالح⟩)

⎕ اسم_الوحدة
⎕ نتيجة_اختبار_موجب[0]
⎕ نتيجة_اختبار_نان[0]
⎕ نتيجة_اختبار_لا_نهائي[0]
⎕ نتيجة_اختبار_فهرس[0]
