إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-UNIFIED-IR-ARENA"

حد_السعة ≔ 8
صفر ≔ 0
مقبول ≔ "PASS"
ممتنع ≔ "ABSTAIN"

عملية_ثابت ≔ "ثابت"
عملية_نص ≔ "تحميل_نص"
عملية_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"

تحقق_فهرس ≡ λقيمة. قيمة ≥ 1 ∧ قيمة ≤ حد_السعة
تحقق_عملية ≡ λقيمة.
  قيمة ≔ عملية_ثابت ∨ قيمة ≔ عملية_نص ∨ قيمة ≔ عملية_حقيقي ∨
  قيمة ≔ عملية_نداء ∨ قيمة ≔ عملية_مجموعة

رمز_ABI ≡ λعملية. λالعقدة. λالرتبة.
  "abi_" ⧺ العملية ⧺ "_" ⧺ نص(العقدة) ⧺ "_" ⧺ نص(الرتبة)

دمج_سجل ≡ λالسجل. λالعقدة. λالرتبة. λالعملية. λالسابق.
  (تحقق_فهرس(السجل) ∧ تحقق_فهرس(العقدة) ∧ تحقق_فهرس(الرتبة) ∧
   تحقق_عملية(العملية) ∧ السجل > السابق) ?
    ⟨مقبول, السجل, العقدة, الرتبة, العملية, رمز_ABI(العملية)(العقدة)(الرتبة), "UNIFIED"⟩ :
    ⟨ممتنع, صفر, صفر, صفر, "", "", "UNIFIED_REJECTED"⟩

موحد_ثابت ≔ دمج_سجل(1)(1)(1)(عملية_ثابت)(0)
موحد_نص ≔ دمج_سجل(2)(2)(2)(عملية_نص)(1)
موحد_حقيقي ≔ دمج_سجل(3)(3)(3)(عملية_حقيقي)(2)
موحد_نداء ≔ دمج_سجل(4)(4)(4)(عملية_نداء)(3)
موحد_مجموعة ≔ دمج_سجل(5)(5)(5)(عملية_مجموعة)(4)

مرفوض_عملية ≔ دمج_سجل(6)(6)(6)("مجهولة")(5)
مرفوض_ترتيب ≔ دمج_سجل(4)(6)(6)(عملية_نداء)(5)
مرفوض_سعة ≔ دمج_سجل(9)(7)(7)(عملية_ثابت)(6)

