إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-IR-SYMBOL-TABLE"

معرف_فارغ ≔ 0
حد_الرموز ≔ 4

نوع_رمز_ثابت ≔ "ثابت"
نوع_رمز_نداء ≔ "نداء"
نوع_رمز_نتيجة ≔ "نتيجة"

تحقق_المعرف ≡ λالمعرف. λالحد.
  المعرف ≥ 1 ∧ المعرف ≤ الحد

تحقق_الرتبة ≡ λالرتبة. λالسابقة.
  (السابقة ≔ 0 ∧ الرتبة ≔ 1) ∨ (السابقة ≥ 1 ∧ الرتبة ≔ السابقة + 1)

اسم_رمز ≡ λالنوع. λالمعرف. λالرتبة.
  "mal_" ⧺ النوع ⧺ "_" ⧺ نص(المعرف) ⧺ "_" ⧺ نص(الرتبة)

إنشاء_رمز ≡ λالنوع. λالمعرف. λالرتبة. λالسابقة.
  (تحقق_المعرف(المعرف)(حد_الرموز) ∧ تحقق_الرتبة(الرتبة)(السابقة)) ?
    ⟨"PASS", اسم_رمز(النوع)(المعرف)(الرتبة), المعرف, الرتبة, "SYMBOL_ACCEPTED"⟩ :
    ⟨"ABSTAIN", "", معرف_فارغ, 0, "INVALID_NODE_OR_ORDINAL"⟩

تحقق_الترتيب ≡ λالمعرف_السابق. λالمعرف_الحالي. λالرتبة_السابقة. λالرتبة_الحالية.
  (المعرف_الحالي > المعرف_السابق) ∨
  (المعرف_الحالي ≔ المعرف_السابق ∧ الرتبة_الحالية > الرتبة_السابقة)

تحقق_التصادم ≡ λاسم_أ. λاسم_ب. اسم_أ ≠ اسم_ب

إدراج_رمز ≡ λالنوع. λالمعرف. λالرتبة. λالسابقة. λالمعرف_السابق.
  (إنشاء_رمز(النوع)(المعرف)(الرتبة)(السابقة)[0] ≔ "PASS" ∧
   تحقق_الترتيب(المعرف_السابق)(المعرف)(السابقة)(الرتبة)) ?
    إنشاء_رمز(النوع)(المعرف)(الرتبة)(السابقة) :
    ⟨"ABSTAIN", "", معرف_فارغ, 0, "NON_CANONICAL_ORDER"⟩

رمز_ثابت_أ ≔ إدراج_رمز(نوع_رمز_ثابت)(1)(1)(0)(0)
رمز_ثابت_ب ≔ إدراج_رمز(نوع_رمز_ثابت)(2)(1)(1)(1)
رمز_نداء_أ ≔ إدراج_رمز(نوع_رمز_نداء)(3)(1)(2)(2)
رمز_نتيجة_أ ≔ إدراج_رمز(نوع_رمز_نتيجة)(4)(1)(3)(3)

حالة_تصادم ≔ تحقق_التصادم(رمز_ثابت_أ[1])(رمز_ثابت_ب[1])
حالة_ترتيب_خاطئ ≔ إدراج_رمز(نوع_رمز_نداء)(2)(1)(1)(3)
حالة_معرف_خارج_الحد ≔ إنشاء_رمز(نوع_رمز_ثابت)(5)(1)(0)
حالة_رتبة_خاطئة ≔ إنشاء_رمز(نوع_رمز_ثابت)(1)(3)(1)

⎕ اسم_الوحدة
⎕ رمز_ثابت_أ[0]
⎕ رمز_ثابت_ب[0]
⎕ رمز_نداء_أ[0]
⎕ رمز_نتيجة_أ[0]
⎕ حالة_تصادم
⎕ حالة_ترتيب_خاطئ[0]
⎕ حالة_معرف_خارج_الحد[0]
⎕ حالة_رتبة_خاطئة[0]
