إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-PARSER-STRING"

رمز_نص ≔ "نص"
رمز_مجهول ≔ "مجهول"
نوع_نص ≔ 4

تحقق_الفهرس ≡ λالفهرس. الفهرس > -1
تحقق_القيمة_النصية ≡ λالقيمة. تحقق_الفهرس(القيمة)

عقدة_نص ≡ λالقيمة. ⟨نوع_نص, القيمة, 0, 0, 0⟩

حلل_نص_آمن ≡ λالرمز.
  (الرمز[0] = رمز_نص ∧ تحقق_القيمة_النصية(الرمز[1])) ?
    ⟨"PASS", عقدة_نص(الرمز[1]), 1, "NONE"⟩ :
    ⟨"ABSTAIN", 0, 0,
      (الرمز[0] = رمز_نص ? "INVALID_VALUE_ID" : "UNKNOWN_TOKEN_KIND")⟩

نتيجة_اختبار_موجب ≔ حلل_نص_آمن(⟨رمز_نص, 7⟩)
نتيجة_اختبار_سالب ≔ حلل_نص_آمن(⟨رمز_نص, -1⟩)
نتيجة_اختبار_مجهول ≔ حلل_نص_آمن(⟨رمز_مجهول, 0⟩)

⎕ اسم_الوحدة
⎕ نتيجة_اختبار_موجب[0]
⎕ نتيجة_اختبار_سالب[0]
⎕ نتيجة_اختبار_مجهول[0]
