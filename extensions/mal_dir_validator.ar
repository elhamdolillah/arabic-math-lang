إصدار_العقد ≔ "0.1.0"
اسم_المخطط ≔ "MAL-DIR"
رأس_الدليل ≔ ⟨"MAL-DIR", "0.1.0", 1, 1, 0⟩
تحقق_الرأس ≡ λالمخطط. المخطط = "MAL-DIR"
تحقق_الإصدار ≡ λالإصدار. الإصدار = "0.1.0"
تحقق_عدد_العقد ≡ λعدد_العقد. عدد_العقد > 0
تحقق_الجذر ≡ λالجذر. الجذر = رأس_الدليل[2]
تحقق_علامة_التنفيذ ≡ λالعلامة. العلامة = 0
الرأس_صالح ≔ تحقق_الرأس(رأس_الدليل[0]) ∧ تحقق_الإصدار(رأس_الدليل[1])
الهيكل_صالح ≔ تحقق_عدد_العقد(رأس_الدليل[2]) ∧ تحقق_الجذر(رأس_الدليل[3])
التنفيذ_صالح ≔ تحقق_علامة_التنفيذ(رأس_الدليل[4])
المدقق_صالح ≔ الرأس_صالح ∧ الهيكل_صالح ∧ التنفيذ_صالح
القرار ≔ المدقق_صالح ؟ "VALID" : "ABSTAIN"
⎕ اسم_المخطط
⎕ القرار
