إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-NODEID"

معرف_فارغ ≔ 0
أول_معرف ≔ 1

تحقق_السعة ≡ λالسعة. السعة > 0
تحقق_المعرف_للقراءة ≡ λالمعرف. λالتالي. المعرف ≥ أول_معرف ∧ المعرف < التالي
تحقق_المعرف_للإدراج ≡ λالمعرف. λالسعة. المعرف ≥ أول_معرف ∧ المعرف ≤ السعة

إدراج_العقدة ≡ λالمعرف. λالسعة.
  (تحقق_السعة(السعة) ∧ تحقق_المعرف_للإدراج(المعرف)(السعة)) ?
    ⟨"PASS", المعرف, "NODEID_ACCEPTED"⟩ :
    ⟨"ABSTAIN", معرف_فارغ, "ARENA_EXHAUSTED_OR_INVALID_CAPACITY"⟩

قراءة_العقدة ≡ λالمعرف. λالتالي.
  (تحقق_المعرف_للقراءة(المعرف)(التالي)) ?
    ⟨"PASS", المعرف, "NODEID_READ_ACCEPTED"⟩ :
    ⟨"ABSTAIN", معرف_فارغ, "NODEID_OUT_OF_RANGE"⟩

نتيجة_إدراج_صحيح ≔ إدراج_العقدة(1)(4)
نتيجة_إدراج_آخر_موضع ≔ إدراج_العقدة(4)(4)
نتيجة_إدراج_منتهية ≔ إدراج_العقدة(5)(4)
نتيجة_قراءة_صفر ≔ قراءة_العقدة(0)(4)
نتيجة_قراءة_خارجية ≔ قراءة_العقدة(4)(4)

