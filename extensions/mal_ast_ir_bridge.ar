إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-AST-IR-BRIDGE"

فارغ ≔ 0
حد_العناصر ≔ 8

عملية_ثابت ≔ "ثابت"
عملية_تحميل_نص ≔ "تحميل_نص"
عملية_تحميل_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"
ممنوع ≔ "ممنوع"

تحقق_حد ≡ λالقيمة. القيمة ≥ 1 ∧ القيمة ≤ حد_العناصر
تحقق_عملية ≡ λالقيمة.
  القيمة ≔ عملية_ثابت ∨ القيمة ≔ عملية_تحميل_نص ∨
  القيمة ≔ عملية_تحميل_حقيقي ∨ القيمة ≔ عملية_نداء ∨ القيمة ≔ عملية_مجموعة

رمز_الربط ≡ λالعقدة. λالرتبة.
  "mal_bridge_" ⧺ نص(العقدة) ⧺ "_" ⧺ نص(الرتبة)

ربط_حتمي ≡ λالعقدة. λالعملية. λالرتبة. λالسابق.
  (تحقق_حد(العقدة) ∧ تحقق_حد(الرتبة) ∧ تحقق_عملية(العملية) ∧ العقدة > السابق) ?
    ⟨"PASS", العقدة, الرتبة, العملية, رمز_الربط(العقدة)(الرتبة), "BRIDGE_ACCEPTED"⟩ :
    ⟨"ABSTAIN", فارغ, 0, ممنوع, "", "BRIDGE_REJECTED"⟩

جسر_ثابت ≔ ربط_حتمي(1)(عملية_ثابت)(1)(0)
جسر_نص ≔ ربط_حتمي(2)(عملية_تحميل_نص)(2)(1)
جسر_حقيقي ≔ ربط_حتمي(3)(عملية_تحميل_حقيقي)(3)(2)
جسر_نداء ≔ ربط_حتمي(4)(عملية_نداء)(4)(3)
جسر_مجموعة ≔ ربط_حتمي(5)(عملية_مجموعة)(5)(4)

جسر_نوع_مجهول ≔ ربط_حتمي(6)("مجهول")(6)(5)
جسر_معرف_مكرر ≔ ربط_حتمي(5)(عملية_نداء)(6)(5)
جسر_رتبة_صفر ≔ ربط_حتمي(7)(عملية_مجموعة)(0)(6)
جسر_حد_خارج ≔ ربط_حتمي(9)(عملية_ثابت)(7)(7)

