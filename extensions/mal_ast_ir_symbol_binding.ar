إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-AST-IR-SYMBOL-BINDING"

معرف_فارغ ≔ 0
حد_الربط ≔ 8

عملية_ثابت ≔ "ثابت"
عملية_تحميل_نص ≔ "تحميل_نص"
عملية_تحميل_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"
عملية_ممنوعة ≔ "ممنوعة"

نوع_أولي ≔ "أولي"
نوع_نص ≔ "نص"
نوع_حقيقي ≔ "حقيقي"
نوع_نداء ≔ "نداء"
نوع_أقواس ≔ "أقواس"

تحقق_المعرف ≡ λالمعرف. المعرف ≥ 1 ∧ المعرف ≤ حد_الربط

عملية_النوع ≡ λالنوع.
  النوع ≔ نوع_أولي ? عملية_ثابت :
  النوع ≔ نوع_نص ? عملية_تحميل_نص :
  النوع ≔ نوع_حقيقي ? عملية_تحميل_حقيقي :
  النوع ≔ نوع_نداء ? عملية_نداء :
  النوع ≔ نوع_أقواس ? عملية_مجموعة : عملية_ممنوعة

تحقق_العملية ≡ λالنوع. عملية_النوع(النوع) ≠ عملية_ممنوعة

اسم_الرمز ≡ λالمعرف. λالرتبة.
  "mal_bind_" ⧺ نص(المعرف) ⧺ "_" ⧺ نص(الرتبة)

إنشاء_ربط ≡ λالمعرف. λالنوع. λالرتبة. λالسابق.
  (تحقق_المعرف(المعرف) ∧ تحقق_العملية(النوع) ∧ الرتبة ≥ 1 ∧
   ((السابق ≔ 0 ∧ الرتبة ≔ 1) ∨ (المعرف > السابق))) ?
    ⟨"PASS", المعرف, الرتبة, عملية_النوع(النوع), اسم_الرمز(المعرف)(الرتبة), "BINDING_ACCEPTED"⟩ :
    ⟨"ABSTAIN", معرف_فارغ, 0, عملية_ممنوعة, "", "BINDING_REJECTED"⟩

ربط_أولي ≔ إنشاء_ربط(1)(نوع_أولي)(1)(0)
ربط_نص ≔ إنشاء_ربط(2)(نوع_نص)(2)(1)
ربط_حقيقي ≔ إنشاء_ربط(3)(نوع_حقيقي)(3)(2)
ربط_نداء ≔ إنشاء_ربط(4)(نوع_نداء)(4)(3)
ربط_أقواس ≔ إنشاء_ربط(5)(نوع_أقواس)(5)(4)

ربط_نوع_مجهول ≔ إنشاء_ربط(6)("مجهول")(6)(5)
ربط_معرف_خارج_الحد ≔ إنشاء_ربط(9)(نوع_نص)(7)(6)
ربط_ترتيب_متراجع ≔ إنشاء_ربط(3)(نوع_حقيقي)(6)(5)
ربط_عملية_ممنوعة ≔ إنشاء_ربط(7)("مجهول")(7)(6)

