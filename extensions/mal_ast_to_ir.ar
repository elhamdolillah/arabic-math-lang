إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-AST-TO-IR"

معرف_فارغ ≔ 0
حد_العقد ≔ 8

نوع_أولي ≔ "أولي"
نوع_نص ≔ "نص"
نوع_حقيقي ≔ "حقيقي"
نوع_نداء ≔ "نداء"
نوع_أقواس ≔ "أقواس"
نوع_غير_مدعوم ≔ "غير_مدعوم"

عملية_ثابت ≔ "ثابت"
عملية_تحميل_نص ≔ "تحميل_نص"
عملية_تحميل_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"

تحقق_العقدة ≡ λالمعرف. λالحد.
  المعرف ≥ 1 ∧ المعرف ≤ الحد

تحقق_النوع ≡ λالنوع.
  النوع ≔ نوع_أولي ∨ النوع ≔ نوع_نص ∨ النوع ≔ نوع_حقيقي ∨ النوع ≔ نوع_نداء ∨ النوع ≔ نوع_أقواس

تحقق_المدخل ≡ λالمعرف. λالنوع.
  تحقق_العقدة(المعرف)(حد_العقد) ∧ تحقق_النوع(النوع)

معرّف_العملية ≡ λالنوع.
  النوع ≔ نوع_أولي ? عملية_ثابت :
  النوع ≔ نوع_نص ? عملية_تحميل_نص :
  النوع ≔ نوع_حقيقي ? عملية_تحميل_حقيقي :
  النوع ≔ نوع_نداء ? عملية_نداء :
  النوع ≔ نوع_أقواس ? عملية_مجموعة : عملية_غير_مدعوم

تطبيع_عقدة ≡ λالمعرف. λالنوع. λالرمز. λالرتبة.
  (تحقق_المدخل(المعرف)(النوع) ∧ الرتبة ≥ 1) ?
    ⟨"PASS", الرتبة, المعرف, معرّف_العملية(النوع), الرمز, "IR_NODE_ACCEPTED"⟩ :
    ⟨"ABSTAIN", 0, معرف_فارغ, عملية_غير_مدعوم, "", "AST_NODE_INVALID_OR_UNSUPPORTED"⟩

تطبيع_أولي ≔ تطبيع_عقدة(1)(نوع_أولي)("س") (1)
تطبيع_نص ≔ تطبيع_عقدة(2)(نوع_نص)("نص") (2)
تطبيع_حقيقي ≔ تطبيع_عقدة(3)(نوع_حقيقي)("حقيقي") (3)
تطبيع_نداء ≔ تطبيع_عقدة(4)(نوع_نداء)("دالة") (4)
تطبيع_أقواس ≔ تطبيع_عقدة(5)(نوع_أقواس)("تعبير") (5)

حالة_معرف_صفر ≔ تطبيع_عقدة(0)(نوع_أولي)("س") (1)
حالة_نوع_مجهول ≔ تطبيع_عقدة(6)(نوع_غير_مدعوم)("؟") (6)
حالة_رتبة_صفر ≔ تطبيع_عقدة(7)(نوع_نص)("نص") (0)
حالة_حد_العقد ≔ تطبيع_عقدة(9)(نوع_حقيقي)("حقيقي") (7)

