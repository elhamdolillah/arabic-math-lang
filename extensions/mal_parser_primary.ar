إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-PARSER-PRIMARY"

رمز_عدد ≔ "عدد"
رمز_صحيح ≔ "صحيح"
رمز_خطأ ≔ "خطأ"
رمز_معرف ≔ "معرف"

نوع_عدد ≔ 1
نوع_منطقي ≔ 2
نوع_اسم ≔ 3

رمز_عدد_صالح ≡ λرمز. رمز[0] = رمز_عدد ∧ رمز[1] > -1
رمز_صحيح_صالح ≡ λرمز. رمز[0] = رمز_صحيح
رمز_خطأ_صالح ≡ λرمز. رمز[0] = رمز_خطأ
رمز_معرف_صالح ≡ λرمز. رمز[0] = رمز_معرف ∧ رمز[1] > -1

تحقق_الفهرس ≡ λالفهرس. الفهرس > -1
تحقق_المعرف ≡ λالمعرف. المعرف > 0

عقدة_عدد ≡ λالقيمة. ⟨نوع_عدد, القيمة, 0, 0, 0⟩
عقدة_منطقي_صحيح ≔ ⟨نوع_منطقي, 1, 0, 0, 0⟩
عقدة_منطقي_خطأ ≔ ⟨نوع_منطقي, 0, 0, 0, 0⟩
عقدة_اسم ≡ λالقيمة. ⟨نوع_اسم, القيمة, 0, 0, 0⟩

حلل_أولي_آمن ≡ λرمز. تحقق_الفهرس(رمز[1]) ?
  (رمز_عدد_صالح(رمز) ? ⟨"PASS", عقدة_عدد(رمز[1]), 1⟩ :
   رمز_صحيح_صالح(رمز) ? ⟨"PASS", عقدة_منطقي_صحيح, 1⟩ :
   رمز_خطأ_صالح(رمز) ? ⟨"PASS", عقدة_منطقي_خطأ, 1⟩ :
   رمز_معرف_صالح(رمز) ? ⟨"PASS", عقدة_اسم(رمز[1]), 1⟩ :
   ⟨"ABSTAIN", 0, 0⟩) : ⟨"ABSTAIN", 0, 0⟩

مثال_عدد ≔ ⟨رمز_عدد, 42, 1, 1⟩
مثال_صحيح ≔ ⟨رمز_صحيح, 0, 1, 1⟩
مثال_خطأ ≔ ⟨رمز_خطأ, 0, 1, 1⟩
مثال_اسم ≔ ⟨رمز_معرف, 7, 1, 1⟩
مثال_مجهول ≔ ⟨"مجهول", 0, 1, 1⟩

نتيجة_عدد ≔ حلل_أولي_آمن(مثال_عدد)
نتيجة_صحيح ≔ حلل_أولي_آمن(مثال_صحيح)
نتيجة_خطأ ≔ حلل_أولي_آمن(مثال_خطأ)
نتيجة_اسم ≔ حلل_أولي_آمن(مثال_اسم)
نتيجة_مجهول ≔ حلل_أولي_آمن(مثال_مجهول)

⎕ اسم_الوحدة
⎕ نتيجة_عدد[0]
⎕ نتيجة_صحيح[0]
⎕ نتيجة_خطأ[0]
⎕ نتيجة_اسم[0]
⎕ نتيجة_مجهول[0]
