إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-PARSER-CALL"

رمز_معرف ≔ "معرف"
رمز_فتح_قوس ≔ "("
رمز_إغلاق_قوس ≔ ")"
رمز_فاصلة ≔ ","
نوع_استدعاء ≔ 6
حد_المعاملات ≔ 2

تحقق_المعرف ≡ λالمعرف. المعرف > 0
تحقق_العقدة ≡ λالمعرف. المعرف > 0
تحقق_إغلاق_قوس ≡ λالرمز. الرمز[0] = رمز_إغلاق_قوس

عقدة_استدعاء_بلا_معاملات ≡ λالهدف. ⟨نوع_استدعاء, الهدف, 0, 0, 0⟩
عقدة_استدعاء_بمعامل ≡ λالهدف. λالمعامل. ⟨نوع_استدعاء, الهدف, المعامل, 0, 1⟩
عقدة_استدعاء_بمعاملين ≡ λالهدف. λالمعامل_الأول. λالمعامل_الثاني. ⟨نوع_استدعاء, الهدف, المعامل_الأول, المعامل_الثاني, 2⟩

حلل_استدعاء_آمن ≡ λالرموز.
  (الرموز[0][0] = رمز_معرف ∧ تحقق_المعرف(الرموز[0][1]) ∧
   الرموز[1][0] = رمز_فتح_قوس) ?
    (تحقق_إغلاق_قوس(الرموز[2]) ?
      ⟨"PASS", عقدة_استدعاء_بلا_معاملات(الرموز[0][1]), 3, "NONE"⟩ :
     (الرموز[2][0] ≠ رمز_فاصلة ∧ تحقق_العقدة(الرموز[2][1]) ∧
      تحقق_إغلاق_قوس(الرموز[3]) ?
        ⟨"PASS", عقدة_استدعاء_بمعامل(الرموز[0][1])(الرموز[2][1]), 4, "NONE"⟩ :
     (تحقق_العقدة(الرموز[2][1]) ∧ الرموز[3][0] = رمز_فاصلة ∧
      تحقق_العقدة(الرموز[4][1]) ∧ تحقق_إغلاق_قوس(الرموز[5]) ?
        ⟨"PASS", عقدة_استدعاء_بمعاملين(الرموز[0][1])(الرموز[2][1])(الرموز[4][1]), 6, "NONE"⟩ :
        ⟨"ABSTAIN", 0, 0, "ARGUMENT_PARSE_ABSTAIN"⟩)) :
    ⟨"ABSTAIN", 0, 0, "INVALID_CALL_TARGET"⟩

نتيجة_بلا_معاملات ≔ حلل_استدعاء_آمن(⟨⟨رمز_معرف, 1⟩, ⟨رمز_فتح_قوس, 0⟩, ⟨رمز_إغلاق_قوس, 0⟩⟩)
نتيجة_بمعامل ≔ حلل_استدعاء_آمن(⟨⟨رمز_معرف, 1⟩, ⟨رمز_فتح_قوس, 0⟩, ⟨"قيمة", 2⟩, ⟨رمز_إغلاق_قوس, 0⟩⟩)
نتيجة_بلا_إغلاق ≔ حلل_استدعاء_آمن(⟨⟨رمز_معرف, 1⟩, ⟨رمز_فتح_قوس, 0⟩, ⟨"قيمة", 2⟩, ⟨رمز_فاصلة, 0⟩⟩)
نتيجة_هدف_غير_صالح ≔ حلل_استدعاء_آمن(⟨⟨رمز_معرف, 0⟩, ⟨رمز_فتح_قوس, 0⟩, ⟨رمز_إغلاق_قوس, 0⟩⟩)

⎕ اسم_الوحدة
⎕ نتيجة_بلا_معاملات[0]
⎕ نتيجة_بمعامل[0]
⎕ نتيجة_بلا_إغلاق[0]
⎕ نتيجة_هدف_غير_صالح[0]
