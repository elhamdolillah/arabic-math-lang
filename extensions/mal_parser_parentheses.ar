إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-PARSER-PARENTHESES"

رمز_عدد ≔ "عدد"
رمز_صحيح ≔ "صحيح"
رمز_خطأ ≔ "خطأ"
رمز_معرف ≔ "معرف"
رمز_فتح_قوس ≔ "("
رمز_إغلاق_قوس ≔ ")"

نوع_عدد ≔ 1
نوع_منطقي ≔ 2
نوع_اسم ≔ 3

تحقق_الفهرس ≡ λالفهرس. الفهرس > -1
تحقق_المعرف ≡ λالمعرف. المعرف > 0

عقدة_عدد ≡ λالقيمة. ⟨نوع_عدد, القيمة, 0, 0, 0⟩
عقدة_منطقي_صحيح ≔ ⟨نوع_منطقي, 1, 0, 0, 0⟩
عقدة_منطقي_خطأ ≔ ⟨نوع_منطقي, 0, 0, 0, 0⟩
عقدة_اسم ≡ λالقيمة. ⟨نوع_اسم, القيمة, 0, 0, 0⟩

رمز_أولي_صالح ≡ λرمز.
  (رمز[0] = رمز_عدد ∧ تحقق_المعرف(رمز[1])) ? عقدة_عدد(رمز[1]) :
  (رمز[0] = رمز_صحيح ∧ تحقق_الفهرس(رمز[1])) ? عقدة_منطقي_صحيح :
  (رمز[0] = رمز_خطأ ∧ تحقق_الفهرس(رمز[1])) ? عقدة_منطقي_خطأ :
  (رمز[0] = رمز_معرف ∧ تحقق_المعرف(رمز[1])) ? عقدة_اسم(رمز[1]) : 0

حلل_قوس_أولي_آمن ≡ λالرموز.
  (الرموز[0][0] = رمز_فتح_قوس ∧ الرموز[2][0] = رمز_إغلاق_قوس) ?
    (رمز_أولي_صالح(الرموز[1]) ≠ 0 ?
      ⟨"PASS", رمز_أولي_صالح(الرموز[1]), 3, "NONE"⟩ :
      ⟨"ABSTAIN", 0, 0, "UNKNOWN_INNER_PRIMARY"⟩) :
    ⟨"ABSTAIN", 0, 0, "MISSING_CLOSING_PAREN"⟩

نتيجة_اختبار_موجب ≔ حلل_قوس_أولي_آمن(⟨⟨رمز_فتح_قوس, 0⟩, ⟨رمز_عدد, 42⟩, ⟨رمز_إغلاق_قوس, 0⟩⟩)
نتيجة_اختبار_سالب ≔ حلل_قوس_أولي_آمن(⟨⟨رمز_فتح_قوس, 0⟩, ⟨رمز_عدد, 42⟩, ⟨"نهاية", 0⟩⟩)

⎕ اسم_الوحدة
⎕ نتيجة_اختبار_موجب[0]
⎕ نتيجة_اختبار_سالب[0]
