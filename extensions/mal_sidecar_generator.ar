إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-SIDECAR-GENERATOR"

حالة_اعتماد ≔ "PROVEN"
حالة_بحث ≔ "RESEARCH"
حالة_امتناع ≔ "ABSTAIN"

بصمة_مفقودة ≔ ""
حد_العناصر ≔ 8

تحقق_البصمة ≡ λالبصمة. البصمة ≠ بصمة_مفقودة
تحقق_العدد ≡ λالعدد. العدد ≥ 1 ∧ العدد ≤ حد_العناصر
تحقق_الحالة ≡ λالحالة. الحالة ≔ حالة_اعتماد ∨ الحالة ≔ حالة_بحث

توليد_سجل ≡ λبصمة_AST. λبصمة_IR. λبصمة_ABI. λالعدد. λالحالة.
  (تحقق_البصمة(بصمة_AST) ∧ تحقق_البصمة(بصمة_IR) ∧ تحقق_البصمة(بصمة_ABI) ∧
   تحقق_العدد(العدد) ∧ تحقق_الحالة(الحالة)) ?
    ⟨"PASS", "0.1.0", بصمة_AST, بصمة_IR, بصمة_ABI, العدد, الحالة, "SIDECAR_CANONICAL"⟩ :
    ⟨حالة_امتناع, "", بصمة_مفقودة, بصمة_مفقودة, بصمة_مفقودة, 0, حالة_امتناع, "SIDECAR_REJECTED"⟩

sidecar_بحث ≔ توليد_سجل("ast_sha256")("ir_sha256")("abi_sha256")(5)(حالة_بحث)
sidecar_اعتماد_ممنوع ≔ توليد_سجل("ast_sha256")("ir_sha256")("abi_sha256")(5)(حالة_اعتماد)
sidecar_بصمة_مفقودة ≔ توليد_سجل(بصمة_مفقودة)("ir_sha256")("abi_sha256")(5)(حالة_بحث)
sidecar_عدد_خارج ≔ توليد_سجل("ast_sha256")("ir_sha256")("abi_sha256")(9)(حالة_بحث)
sidecar_حالة_غير_معروفة ≔ توليد_سجل("ast_sha256")("ir_sha256")("abi_sha256")(5)("UNKNOWN")

