إصدار_العقد ≔ "0.1.0"
اسم_الوحدة ≔ "MAL-ARENA-CODEGEN-DATA-FLOW"
حد_السعة ≔ 8
مقبول ≔ "PASS"
ممتنع ≔ "ABSTAIN"
مهيأ ≔ "CODEGEN_READY"

عملية_ثابت ≔ "ثابت"
عملية_نص ≔ "تحميل_نص"
عملية_حقيقي ≔ "تحميل_حقيقي"
عملية_نداء ≔ "نداء"
عملية_مجموعة ≔ "مجموعة"

مسموح ≡ λعملية.
  عملية ≔ عملية_ثابت ∨ عملية ≔ عملية_نص ∨ عملية ≔ عملية_حقيقي ∨
  عملية ≔ عملية_نداء ∨ عملية ≔ عملية_مجموعة

ضمن_النطاق ≡ λقيمة. قيمة ≥ 1 ∧ قيمة ≤ حد_السعة
رتبة_صحيحة ≡ λحالي. λسابق. حالي > سابق
رمز_موحد ≡ λعملية. λالعقدة. λالرتبة.
  "flow_" ⧺ العملية ⧺ "_" ⧺ نص(العقدة) ⧺ "_" ⧺ نص(الرتبة)

نقل ≡ λالبيان. λالعقدة. λالرتبة. λالعملية. λالسابق.
  (ضمن_النطاق(البيان) ∧ ضمن_النطاق(العقدة) ∧ ضمن_النطاق(الرتبة) ∧
   رتبة_صحيحة(البيان)(السابق) ∧ مسموح(العملية)) ?
   ⟨مقبول, البيان, العقدة, الرتبة, العملية, رمز_موحد(العملية)(العقدة)(الرتبة), مهيأ⟩ :
   ⟨ممتنع, 0, 0, 0, "", "", "FLOW_BLOCKED"⟩

بيان_01 ≔ نقل(1)(1)(1)(عملية_ثابت)(0)
بيان_02 ≔ نقل(2)(2)(2)(عملية_نص)(1)
بيان_03 ≔ نقل(3)(3)(3)(عملية_حقيقي)(2)
بيان_04 ≔ نقل(4)(4)(4)(عملية_نداء)(3)
بيان_05 ≔ نقل(5)(5)(5)(عملية_مجموعة)(4)
رفض_عملية ≔ نقل(6)(6)(6)("ممنوعة")(5)
رفض_رتبة ≔ نقل(5)(7)(7)(عملية_نداء)(6)
رفض_سعة ≔ نقل(9)(8)(8)(عملية_ثابت)(5)

