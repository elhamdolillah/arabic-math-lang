    مفتاح_موضع_٢ ≔ 0
    ⋄ نص_موضع_٢ ≔ موضع_٢
    ⋄ تطابق_٢ ≔ 1
    ⋄ μ مفتاح_موضع_٢ < طول_مفتاح_٢ ∧ تطابق_٢ = 1 : ﴿
        حرف_نص_٢ ≔ رمز_حرف(محتوى_٢، نص_موضع_٢)
        ⋄ حرف_مفتاح_٢ ≔ رمز_حرف(مفتاح_٢، مفتاح_موضع_٢)
        ⋄ تطابق_٢ ≔ حرف_نص_٢ = حرف_مفتاح_٢ ؟ 1 : 0
        ⋄ عرض_نص_٢ ≔ عرض_حرف(محتوى_٢، نص_موضع_٢)
        ⋄ عرض_مفتاح_٢ ≔ عرض_حرف(مفتاح_٢، مفتاح_موضع_٢)
        ⋄ نص_موضع_٢ ≔ نص_موضع_٢ + عرض_نص_٢
        ⋄ مفتاح_موضع_٢ ≔ مفتاح_موضع_٢ + عرض_مفتاح_٢
    ﴾
    ⋄ نتيجة_٢ ≔ تطابق_٢ = 1 ؟ موضع_حرف_٢ : نتيجة_٢
    ⋄ حرف_خارجي_٢ ≔ رمز_حرف(محتوى_٢، موضع_٢)
    ⋄ عرض_خارجي_٢ ≔ عرض_حرف(محتوى_٢، موضع_٢)
    ⋄ موضع_٢ ≔ موضع_٢ + عرض_خارجي_٢
    ⋄ موضع_حرف_٢ ≔ موضع_حرف_٢ + 1
﴾
⎕ نتيجة_٢

