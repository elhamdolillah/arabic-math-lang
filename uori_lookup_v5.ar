محتوى_٥ ≔ "a b c"
مفتاح_٥ ≔ "b"
طول_محتوى_٥ ≔ طول(محتوى_٥)
طول_مفتاح_٥ ≔ طول(مفتاح_٥)
موضع_٥ ≔ 0
موضع_حرف_٥ ≔ 0
نتيجة_٥ ≔ -1
μ موضع_٥ ≤ طول_محتوى_٥ - طول_مفتاح_٥ ∧ نتيجة_٥ = -1 : ﴿
    حرف_نص_٥ ≔ رمز_حرف(محتوى_٥، موضع_٥)
    ⋄ تطابق_٥ ≔ حرف_نص_٥ = رمز_حرف(مفتاح_٥، 0) ؟ 1 : 0
    ⋄ نتيجة_٥ ≔ تطابق_٥ = 1 ؟ موضع_حرف_٥ : نتيجة_٥
    ⋄ موضع_٥ ≔ موضع_٥ + 1
    ⋄ موضع_حرف_٥ ≔ موضع_حرف_٥ + 1
﴾
⎕ نتيجة_٥
