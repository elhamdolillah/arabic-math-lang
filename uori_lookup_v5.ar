محتوى_١ ≔ "abc-مرحبا-xyz"
مفتاح_١ ≔ "مرحبا"
طول_محتوى_١ ≔ طول(محتوى_١)
طول_مفتاح_١ ≔ طول(مفتاح_١)
موضع_١ ≔ 0
موضع_حرف_١ ≔ 0
نتيجة_١ ≔ -1
μ موضع_١ ≤ طول_محتوى_١ - طول_مفتاح_١ ∧ نتيجة_١ = -1 : ﴿
    مفتاح_موضع_١ ≔ 0
    ⋄ نص_موضع_١ ≔ موضع_١
    ⋄ تطابق_١ ≔ 1
    ⋄ μ مفتاح_موضع_١ < طول_مفتاح_١ ∧ تطابق_١ = 1 : ﴿
        حرف_نص_١ ≔ رمز_حرف(محتوى_١، نص_موضع_١)
        ⋄ حرف_مفتاح_١ ≔ رمز_حرف(مفتاح_١، مفتاح_موضع_١)
        ⋄ تطابق_١ ≔ حرف_نص_١ = حرف_مفتاح_١ ؟ 1 : 0
        ⋄ عرض_نص_١ ≔ عرض_حرف(محتوى_١، نص_موضع_١)
        ⋄ عرض_مفتاح_١ ≔ عرض_حرف(مفتاح_١، مفتاح_موضع_١)
        ⋄ نص_موضع_١ ≔ نص_موضع_١ + عرض_نص_١
        ⋄ مفتاح_موضع_١ ≔ مفتاح_موضع_١ + عرض_مفتاح_١
    ﴾
    ⋄ نتيجة_١ ≔ تطابق_١ = 1 ؟ موضع_حرف_١ : نتيجة_١
    ⋄ حرف_خارجي_١ ≔ رمز_حرف(محتوى_١، موضع_١)
    ⋄ عرض_خارجي_١ ≔ عرض_حرف(محتوى_١، موضع_١)
    ⋄ موضع_١ ≔ موضع_١ + عرض_خارجي_١
    ⋄ موضع_حرف_١ ≔ موضع_حرف_١ + 1
﴾
⎕ نتيجة_١

محتوى_٢ ≔ "جذر:16:وقود:100"
