# المرحلة 41: القنوات — pipe2 syscall
# تواصل بين العمليات والخيوط

# مثال 1: قناة بسيطة
⎕ "=== مثال 1: قناة بسيطة ==="
ق ≔ قناة()
أرسل(ق، 100)
ر ≔ استقبل(ق)
⎕ "استلمت: "
⎕ نص(ر)

# مثال 2: قناة بين خيطَين
⎕ "=== مثال 2: خيطَين عبر قناة ==="
ق٢ ≔ قناة()
منتج ≡ λ(). ﴿
    ⎕ "[منتج] إرسال 99"
    ⋄ أرسل(ق٢، 99)
﴾
خ ≔ توازي(منتج، 0)
ر٢ ≔ استقبل(ق٢)
⎕ "[مستهلك] استلمت: "
⎕ نص(ر٢)