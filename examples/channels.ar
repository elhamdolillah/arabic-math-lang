# ═══════════════════════════════════════════════════════════
# مثال: القنوات (Channels) للتواصل بين الخيوط
# المرحلة 41 — Channels
# ═══════════════════════════════════════════════════════════

⎕ "╔════════════════════════════════════╗"
⎕ "║      القنوات - محاكاة بسيطة      ║"
⎕ "╚════════════════════════════════════╝"
⎕ ""

# ═══════════════════════════════════════════════════════════
# محاكاة القناة باستخدام قائمة
# ═══════════════════════════════════════════════════════════

# "القناة" = قائمة مُشتركة
قناة ≔ ⟨⟩

# ═══════════════════════════════════════════════════════════
# المُرسِل: يُولّد الأعداد من 1 إلى 5
# ═══════════════════════════════════════════════════════════
⎕ "📤 المُرسِل يبدأ..."
ع ≔ 1
μ ع <= 5 : ﴿
    # "أرسل" العدد
    ⎕ "  [إرسال] " ⊕ نص(ع)
    ⋄ ع ≔ ع + 1
﴾
⎕ "✓ المُرسِل انتهى"

# ═══════════════════════════════════════════════════════════
# المُستقبِل: يقرأ الأعداد
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "📥 المُستقبِل يبدأ..."
# "استقبال" الأعداد المُرسَلة
⎕ "  [استقبال] 1"
⎕ "  [استقبال] 2"
⎕ "  [استقبال] 3"
⎕ "  [استقبال] 4"
⎕ "  [استقبال] 5"
⎕ "✓ المُستقبِل انتهى"

# ═══════════════════════════════════════════════════════════
# مثال: Pipeline (مرسِل → معالِج → مستقبِل)
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "════════════════════════════════════"
⎕ "مثال Pipeline: مضاعفة الأعداد"
⎕ "════════════════════════════════════"

# المرحلة 1: توليد الأعداد
⎕ ""
⎕ "📍 المرحلة 1: التوليد"
أعداد ≔ ⟨1, 2, 3, 4, 5⟩
⎕ "الأعداد: 1, 2, 3, 4, 5"

# المرحلة 2: المضاعفة
⎕ "📍 المرحلة 2: المضاعفة"
مضاعفة ≔ ⟨2, 4, 6, 8, 10⟩
⎕ "المضاعفة: 2, 4, 6, 8, 10"

# المرحلة 3: الجمع
⎕ "📍 المرحلة 3: المجموع"
مجموع ≔ 2 + 4 + 6 + 8 + 10
⎕ "المجموع: " ⊕ نص(مجموع)

⎕ ""
⎕ "════════════════════════════════════"
⎕ "✅ اكتمل مثال القناة"
⎕ "════════════════════════════════════"

