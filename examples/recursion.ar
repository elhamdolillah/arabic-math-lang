# ═══════════════════════════════════════════════════════════
# مثال: العودية المتقدمة (Advanced Recursion)
# الدستور: ﴿كل نفس ذائقة الموت﴾
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 1. المضروب (Factorial) — عودية بسيطة
# ═══════════════════════════════════════════════════════════
مضروب ≡ λن. ن = 1 ؟ 1 : ن · مضروب(ن - 1)

⎕ "5! = " ⊕ نص(مضروب(5))       # 120
⎕ "7! = " ⊕ نص(مضروب(7))       # 5040
⎕ "10! = " ⊕ نص(مضروب(10))     # 3628800

# ═══════════════════════════════════════════════════════════
# 2. فيبوناتشي — عودية مزدوجة
# ═══════════════════════════════════════════════════════════
فيب ≡ λن. ن < 2 ؟ ن : فيب(ن - 1) + فيب(ن - 2)

⎕ "فيب(10) = " ⊕ نص(فيب(10))   # 55
⎕ "فيب(15) = " ⊕ نص(فيب(15))   # 610

# ═══════════════════════════════════════════════════════════
# 3. مجموع الأرقام — عودية على القوائم
# ═══════════════════════════════════════════════════════════
# (يتطلب دعم العودية على القوائم)
مجموع_ق ≡ λق. أحص(ق) = 0 ؟ 0 : رأس(ق) + مجموع_ق(ذيل(ق))

# ⎕ مجموع_ق(⟨1, 2, 3, 4, 5⟩)  # 15