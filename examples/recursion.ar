# ═══════════════════════════════════════════════════════════
# مثال: الحلقات التكرارية (بديل العودية)
# الدستور: ﴿كل نفس ذائقة الموت﴾
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 1. حساب المضروب 5! = 120
# ═══════════════════════════════════════════════════════════
⎕ "5! ="
ن ≔ 5
نتيجة ≔ 1
ع ≔ 1
μ ع <= ن : ﴿
    نتيجة ≔ نتيجة · ع
    ⋄ ع ≔ ع + 1
﴾
⎕ نتيجة

# ═══════════════════════════════════════════════════════════
# 2. فيبوناتشي (أول 10 حدود)
# ═══════════════════════════════════════════════════════════
⎕ "فيبوناتشي:"
أ ≔ 0
ب ≔ 1
ع ≔ 0
حد ≔ 10

μ ع < حد : ﴿
    ⎕ أ
    ⋄ ت ≔ أ + ب
    ⋄ أ ≔ ب
    ⋄ ب ≔ ت
    ⋄ ع ≔ ع + 1
﴾

# ═══════════════════════════════════════════════════════════
# 3. مجموع الأعداد من 1 إلى 100
# ═══════════════════════════════════════════════════════════
⎕ "مجموع 1 إلى 100:"
مجموع ≔ 0
ع ≔ 1
μ ع <= 100 : ﴿
    مجموع ≔ مجموع + ع
    ⋄ ع ≔ ع + 1
﴾
⎕ مجموع
