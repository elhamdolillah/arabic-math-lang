# ═══════════════════════════════════════════════════════════
# مثال: المزاليج (Mutexes) للمزامنة
# المرحلة 41 — Mutexes
# ═══════════════════════════════════════════════════════════

⎕ "╔════════════════════════════════════╗"
⎕ "║      المزاليج - محاكاة           ║"
⎕ "╚════════════════════════════════════╝"
⎕ ""

# ═══════════════════════════════════════════════════════════
# عداد مشترك (محمي بمزلاج افتراضي)
# ═══════════════════════════════════════════════════════════
عداد ≔ 0

# ═══════════════════════════════════════════════════════════
# الخيط 1: يزيد العداد 5 مرات
# ═══════════════════════════════════════════════════════════
⎕ "🔒 الخيط 1 يكتسب المزلاج..."
ع١ ≔ 1
μ ع١ <= 5 : ﴿
    ⎕ "  [خيط 1] أغلق(مزلاج)"
    ⋄ عداد ≔ عداد + 1
    ⋄ ⎕ "  [خيط 1] العداد = " ⊕ نص(عداد)
    ⋄ ⎕ "  [خيط 1] افتح(مزلاج)"
    ⋄ ع١ ≔ ع١ + 1
﴾

# ═══════════════════════════════════════════════════════════
# الخيط 2: يزيد العداد 5 مرات أخرى
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "🔒 الخيط 2 يكتسب المزلاج..."
ع٢ ≔ 1
μ ع٢ <= 5 : ﴿
    ⎕ "  [خيط 2] أغلق(مزلاج)"
    ⋄ عداد ≔ عداد + 1
    ⋄ ⎕ "  [خيط 2] العداد = " ⊕ نص(عداد)
    ⋄ ⎕ "  [خيط 2] افتح(مزلاج)"
    ⋄ ع٢ ≔ ع٢ + 1
﴾

# ═══════════════════════════════════════════════════════════
# النتيجة النهائية
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "════════════════════════════════════"
⎕ "العداد النهائي: " ⊕ نص(عداد)
⎕ "════════════════════════════════════"
⎕ ""
⎕ "المتوقع: 10 (5 + 5)"

# ═══════════════════════════════════════════════════════════
# مثال: Producer-Consumer مع مزلاج
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "════════════════════════════════════"
⎕ "مثال: منتج ومستهلك"
⎕ "════════════════════════════════════"

# المخزون
مخزون ≔ 0

# المُنتج
⎕ "🏭 المُنتج: ينتج 3 وحدات"
ع ≔ 1
μ ع <= 3 : ﴿
    ⎕ "  [منتج] إنتاج وحدة " ⊕ نص(ع)
    ⋄ مخزون ≔ مخزون + 1
    ⋄ ع ≔ ع + 1
﴾

# المستهلك
⎕ "🛒 المستهلك: يستهلك 2 وحدة"
ع ≔ 1
μ ع <= 2 : ﴿
    ⎕ "  [مستهلك] استهلاك وحدة " ⊕ نص(ع)
    ⋄ مخزون ≔ مخزون - 1
    ⋄ ع ≔ ع + 1
﴾

⎕ ""
⎕ "المخزون المتبقي: " ⊕ نص(مخزون)
⎕ "المتوقع: 1 (3 - 2)"

⎕ ""
⎕ "✅ اكتمل مثال المزاليج"

