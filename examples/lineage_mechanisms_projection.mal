// إسقاط حتمي محدود من آليات اللغات التاريخية إلى MAL v0.1
// لا يمثل هذا الملف تنفيذًا للغات الأصلية؛ إنه corpus مصدر للتحليل الساكن فقط.
// الآليات غير الممثلة في Grammar v0.1 تبقى RESEARCH أو DENY وفق العقد.

بنية عقد_حتمي {
    عدد_صحيح قيمة;
    منطقي صالح;
}

عدد_صحيح جمع_صحيح(ثابت عدد_صحيح أ, ثابت عدد_صحيح ب) {
    عدد_صحيح ناتج = أ + ب;
    أرجع ناتج;
}

منطقي تحقق_حدود(ثابت عدد_صحيح قيمة, ثابت عدد_صحيح أدنى, ثابت عدد_صحيح أقصى) {
    إذا (قيمة >= أدنى && قيمة <= أقصى) {
        أرجع صحيح;
    } وإلا {
        أرجع خطأ;
    }
}

عدد_صحيح قسمة_آمنة(ثابت عدد_صحيح بسط, ثابت عدد_صحيح مقام) {
    إذا (مقام == 0) {
        أرجع 0;
    } وإلا {
        أرجع بسط / مقام;
    }
}

عدد_صحيح مجموع_محدد(ثابت عدد_صحيح بداية, ثابت عدد_صحيح نهاية) {
    عدد_صحيح مجموع = 0;
    لكل (عدد_صحيح س = بداية; س <= نهاية; س = س + 1) {
        مجموع = مجموع + س;
    }
    أرجع مجموع;
}

منطقي قرار_ثلاثي(ثابت منطقي دليل, ثابت منطقي مخالفة) {
    إذا (مخالفة == صحيح) {
        أرجع خطأ;
    } وإلا {
        إذا (دليل == صحيح) {
            أرجع صحيح;
        } وإلا {
            أرجع خطأ;
        }
    }
}
