# مثال: قراءة وكتابة الملفات
# الدستور: ﴿اقرأ باسم ربك﴾
# ═══════════════════════════════════════════════════════════

# 1. كتابة إلى ملف
ملف_كتابة ≔ فتح("test.txt")
اكتب_ملف(ملف_كتابة, "السلام عليكم\n")
اكتب_ملف(ملف_كتابة, "هذا اختبار للملفات\n")
اكتب_ملف(ملف_كتابة, "اللغة العربية الرياضية\n")
اختم(ملف_كتابة)
⎕ "تم كتابة الملف بنجاح"

# 2. القراءة من ملف
ملف_قراءة ≔ فتح("test.txt")
محتوى ≔ اقرأ_ملف(ملف_قراءة, 4096)
اختم(ملف_قراءة)

⎕ "محتوى الملف:"
⎕ محتوى