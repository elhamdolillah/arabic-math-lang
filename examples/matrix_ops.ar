# ═══════════════════════════════════════════════════════════
# مثال: عمليات المصفوفات المتقدمة
# المرحلة 31-32 — ﴿والصافات صفاً﴾
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 1. محدد مصفوفة 2×2
# ═══════════════════════════════════════════════════════════
⎕ "=== محدد مصفوفة 2×2 ==="
# | أ ب |   | 1 2 |
# | ج د | = | 3 4 |
أ ≔ 1
ب ≔ 2
ج ≔ 3
د ≔ 4

محدد ≔ أ · د - ب · ج
⎕ "det([1,2;3,4]) = "
⎕ محدد    # -2

# ═══════════════════════════════════════════════════════════
# 2. جمع مصفوفتين
# ═══════════════════════════════════════════════════════════
⎕ "=== جمع مصفوفتين ==="
# مصفوفة 1
أ١ ≔ 1
ب١ ≔ 2
ج١ ≔ 3
د١ ≔ 4

# مصفوفة 2
أ٢ ≔ 5
ب٢ ≔ 6
ج٢ ≔ 7
د٢ ≔ 8

# الجمع
أ_ج ≔ أ١ + أ٢
ب_ج ≔ ب١ + ب٢
ج_ج ≔ ج١ + ج٢
د_ج ≔ د١ + د٢

⎕ "[1,2;3,4] + [5,6;7,8] ="
⎕ "   ["
⎕ أ_ج
⎕ ب_ج
⎕ "   ;"
⎕ ج_ج
⎕ د_ج
⎕ "   ]"
# الناتج: [6,8;10,12]

# ═══════════════════════════════════════════════════════════
# 3. ضرب مصفوفة في عدد
# ═══════════════════════════════════════════════════════════
⎕ "=== ضرب في عدد ==="
معامل ≔ 3
أ_ض ≔ أ١ · معامل
ب_ض ≔ ب١ · معامل
ج_ض ≔ ج١ · معامل
د_ض ≔ د١ · معامل

⎕ "3 × [1,2;3,4] ="
⎕ أ_ض
⎕ ب_ض
⎕ ج_ض
⎕ د_ض
# الناتج: [3,6;9,12]

# ═══════════════════════════════════════════════════════════
# 4. منقول المصفوفة (Transpose)
# ═══════════════════════════════════════════════════════════
⎕ "=== المنقول ==="
# | أ ب |^T   | أ ج |
# | ج د |   = | ب د |
⎕ "[1,2;3,4]^T ="
⎕ أ
⎕ ج
⎕ ب
⎕ د
# الناتج: [1,3;2,4]
