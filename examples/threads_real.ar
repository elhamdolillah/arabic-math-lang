# ═══════════════════════════════════════════════════════════
# مثال 1: عداد مشترك مع mutex
# ═══════════════════════════════════════════════════════════
⎕ "📊 مثال 1: عداد محمي بمزلاج"
⎕ "─────────────────────────────"

# المزلاج والعداد
قفل ≔ مزلاج()
عداد ≔ 0

# دالة الزيادة الآمنة
زيادة ≡ λ(). ﴿
    ع ≔ 1
    ⋄ μ ع <= 10 : ﴿
        أغلق(قفل)
        ⋄ عداد ≔ عداد + 1
        ⋄ افتح(قفل)
        ⋄ ع ≔ ع + 1
    ﴾
﴾

# إنشاء خيطَين
⎕ "إنشاء خيطَين..."
خ١ ≔ خيط(زيادة)
خ٢ ≔ خيط(زيادة)

# الانتظار
⎕ "انتظار الانتهاء..."
انتظر(خ١)
انتظر(خ٢)

# النتيجة
⎕ "العداد النهائي: " ⊕ نص(عداد)
⎕ "المتوقع: 20 (10 + 10)"
⎕ ""

# ═══════════════════════════════════════════════════════════
# مثال 2: قناة بين خيطَين
# ═══════════════════════════════════════════════════════════
⎕ "📡 مثال 2: قناة (Producer-Consumer)"
⎕ "───────────────────────────────────"

ق ≔ قناة()

# المنتج
منتج ≡ λ(). ﴿
    ع ≔ 1
    ⋄ μ ع <= 3 : ﴿
        ⎕ "[منتج] إرسال: " ⊕ نص(ع)
        ⋄ أرسل(ق، ع)
        ⋄ ع ≔ ع + 1
    ﴾
﴾

# المستهلك
مستهلك ≡ λ(). ﴿
    ع ≔ 1
    ⋄ μ ع <= 3 : ﴿
        قيمة ≔ استقبل(ق)
        ⋄ ⎕ "[مستهلك] استلام: " ⊕ نص(قيمة)
        ⋄ ع ≔ ع + 1
    ﴾
﴾

⎕ "تشغيل المنتج والمستهلك..."
خ١ ≔ خيط(منتج)
خ٢ ≔ خيط(مستهلك)

انتظر(خ١)
انتظر(خ٢)

⎕ ""
⎕ "════════════════════════════════════"
⎕ "✅ اكتملت أمثلة التوازي الحقيقي!"
⎕ "════════════════════════════════════"