# ═══════════════════════════════════════════════════════════
# مثال: التوازي الحقيقي - نسخة مبسطة
# المرحلة 41 — محاكاة التوازي
# ═══════════════════════════════════════════════════════════

⎕ "╔════════════════════════════════════╗"
⎕ "║     التوازي - محاكاة عملية          ║"
⎕ "╚════════════════════════════════════╝"
⎕ ""

# ═══════════════════════════════════════════════════════════
# مثال 1: محاكاة خيطَين يعملان بالتوازي
# ═══════════════════════════════════════════════════════════
⎕ "📊 مثال 1: محاكاة خيطَين"
⎕ "─────────────────────────────"

# الخيط الأول: عداد
⎕ "[خيط 1] يبدأ العد..."
ع١ ≔ 1
μ ع١ <= 5 : ﴿
    ⎕ "  [خيط 1] " ⊕ نص(ع١)
    ⋄ ع١ ≔ ع١ + 1
﴾
⎕ "[خيط 1] انتهى ✓"

# الخيط الثاني: عداد آخر
⎕ ""
⎕ "[خيط 2] يبدأ العد..."
ع٢ ≔ 10
μ ع٢ <= 15 : ﴿
    ⎕ "  [خيط 2] " ⊕ نص(ع٢)
    ⋄ ع٢ ≔ ع٢ + 1
﴾
⎕ "[خيط 2] انتهى ✓"

# ═══════════════════════════════════════════════════════════
# مثال 2: محاكاة قناة (Producer-Consumer)
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "📡 مثال 2: محاكاة قناة"
⎕ "─────────────────────────────"

# "القناة" = متغير مشترك
رسالة ≔ 0

# المنتج
⎕ "[منتج] إرسال..."
رسالة ≔ 42
⎕ "  [منتج] أرسل: " ⊕ نص(رسالة)

# المستهلك
⎕ "[مستهلك] استقبال..."
⎕ "  [مستهلك] استلم: " ⊕ نص(رسالة)

# ═══════════════════════════════════════════════════════════
# مثال 3: محاكاة مزلاج (Mutex)
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "🔒 مثال 3: محاكاة مزلاج"
⎕ "─────────────────────────────"

عداد ≔ 0

# المنطقة الحرجة 1
⎕ "[خيط 1] أغلق(مزلاج)"
عداد ≔ عداد + 1
⎕ "  العداد = " ⊕ نص(عداد)
⎕ "[خيط 1] افتح(مزلاج)"

# المنطقة الحرجة 2
⎕ "[خيط 2] أغلق(مزلاج)"
عداد ≔ عداد + 1
⎕ "  العداد = " ⊕ نص(عداد)
⎕ "[خيط 2] افتح(مزلاج)"

⎕ ""
⎕ "العداد النهائي: " ⊕ نص(عداد)
⎕ "المتوقع: 2"

⎕ ""
⎕ "════════════════════════════════════"
⎕ "✅ اكتملت محاكاة التوازي"
⎕ "════════════════════════════════════"
⎕ ""
⎕ "ملاحظة: التوازي الحقيقي عبر clone/pipe2/futex"
