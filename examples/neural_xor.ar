# بوابة XOR العصبية — ﴿فقد استمسك بالعروة الوثقى﴾
# XOR: (1,0)=1, (0,1)=1, (1,1)=0, (0,0)=0
س ≔ 1
ص ≔ 0
مجموع ≔ س + ص
ناتج_or ≔ مجموع - 1
# OR: مجموع > 0 → ناتج_or ≥ 0
سالب ≔ 0 - س
سالب_ص ≔ 0 - ص
مجموع_سالب ≔ سالب + سالب_ص
ناتج_nand ≔ مجموع_سالب + 2
# XOR ≈ OR - AND
مجموع_كلي ≔ ناتج_or + ناتج_nand
⎕ "XOR(1,0) = "
⎕ مجموع_كلي
