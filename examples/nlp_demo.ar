# ═══════════════════════════════════════════════════════════
# مثال: معالجة اللغة العربية (NLP Demo)
# المرحلة 37 — ﴿بلسان عربي مبين﴾
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 1. تحليل جملة عربية
# ═══════════════════════════════════════════════════════════
كلمات ≔ ⟨"الطالب", "يكتب", "الدرس"⟩
أنواع ≔ ⟨"اسم", "فعل", "اسم"⟩

⎕ "الجملة: الطالب يكتب الدرس"
⎕ "عدد الكلمات: " ⊕ نص(أحص(كلمات))

# ═══════════════════════════════════════════════════════════
# 2. استخراج الجذور
# ═══════════════════════════════════════════════════════════
جذر_طالب ≔ "طلب"
جذر_يكتب ≔ "كتب"
جذر_الدرس ≔ "درس"

⎕ "الجذور: " ⊕ جذر_طالب ⊕ "، " ⊕ جذر_يكتب ⊕ "، " ⊕ جذر_الدرس

# ═══════════════════════════════════════════════════════════
# 3. تصنيف الكلمات
# ═══════════════════════════════════════════════════════════
أسماء ≔ 2
أفعال ≔ 1
⎕ "أسماء: " ⊕ نص(أسماء)
⎕ "أفعال: " ⊕ نص(أفعال)