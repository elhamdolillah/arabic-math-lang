# ═══════════════════════════════════════════════════════════
# مثال: الجمع المتوازي
# المرحلة 41 — Parallel Sum
# ═══════════════════════════════════════════════════════════

⎕ "╔════════════════════════════════════╗"
⎕ "║         الجمع المتوازي            ║"
⎕ "╚════════════════════════════════════╝"
⎕ ""

# ═══════════════════════════════════════════════════════════
# المشكلة: جمع الأعداد من 1 إلى 100
# ═══════════════════════════════════════════════════════════
⎕ "المشكلة: مجموع 1 إلى 100"
⎕ "الحل المتسلسل:"

# الحل المتسلسل
مجموع_متسلسل ≔ 0
ع ≔ 1
μ ع <= 100 : ﴿
    مجموع_متسلسل ≔ مجموع_متسلسل + ع
    ⋄ ع ≔ ع + 1
﴾
⎕ "النتيجة: " ⊕ نص(مجموع_متسلسل)
⎕ "المتوقع: 5050"

# ═══════════════════════════════════════════════════════════
# الحل المتوازي (محاكاة): تقسيم العمل على 4 خيوط
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "════════════════════════════════════"
⎕ "الحل المتوازي: 4 خيوط"
⎕ "════════════════════════════════════"

# ═══════════════════════════════════════════════════════════
# الخيط 1: 1 إلى 25
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "📍 الخيط 1: مجموع 1 إلى 25"
ج١ ≔ 0
ع ≔ 1
μ ع <= 25 : ﴿
    ج١ ≔ ج١ + ع
    ⋄ ع ≔ ع + 1
﴾
⎕ "  النتيجة: " ⊕ نص(ج١)

# ═══════════════════════════════════════════════════════════
# الخيط 2: 26 إلى 50
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "📍 الخيط 2: مجموع 26 إلى 50"
ج٢ ≔ 0
ع ≔ 26
μ ع <= 50 : ﴿
    ج٢ ≔ ج٢ + ع
    ⋄ ع ≔ ع + 1
﴾
⎕ "  النتيجة: " ⊕ نص(ج٢)

# ═══════════════════════════════════════════════════════════
# الخيط 3: 51 إلى 75
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "📍 الخيط 3: مجموع 51 إلى 75"
ج٣ ≔ 0
ع ≔ 51
μ ع <= 75 : ﴿
    ج٣ ≔ ج٣ + ع
    ⋄ ع ≔ ع + 1
﴾
⎕ "  النتيجة: " ⊕ نص(ج٣)

# ═══════════════════════════════════════════════════════════
# الخيط 4: 76 إلى 100
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "📍 الخيط 4: مجموع 76 إلى 100"
ج٤ ≔ 0
ع ≔ 76
μ ع <= 100 : ﴿
    ج٤ ≔ ج٤ + ع
    ⋄ ع ≔ ع + 1
﴾
⎕ "  النتيجة: " ⊕ نص(ج٤)

# ═══════════════════════════════════════════════════════════
# دمج النتائج
# ═══════════════════════════════════════════════════════════
⎕ ""
⎕ "════════════════════════════════════"
⎕ "📊 دمج النتائج"
⎕ "════════════════════════════════════"
المجموع_الكلي ≔ ج١ + ج٢ + ج٣ + ج٤
⎕ "ج١ = " ⊕ نص(ج١)
⎕ "ج٢ = " ⊕ نص(ج٢)
⎕ "ج٣ = " ⊕ نص(ج٣)
⎕ "ج٤ = " ⊕ نص(ج٤)
⎕ "───────────────────"
⎕ "المجموع = " ⊕ نص(المجموع_الكلي)
⎕ ""
⎕ "المتوقع: 5050"

# ═══════════════════════════════════════════════════════════
# التحقق
# ═══════════════════════════════════════════════════════════
صحيح ≔ المجموع_الكلي = مجموع_متسلسل
⎕ ""
⎕ صحيح ؟ "✅ النتائج متطابقة!" : "❌ خطأ في الحساب"

⎕ ""
⎕ "════════════════════════════════════"
⎕ "✅ اكتمل مثال الجمع المتوازي"
⎕ "════════════════════════════════════"
⎕ ""
⎕ "مزايا التوازي:"
⎕ "• سرعة أعلى (4 خيوط ≈ 4× أسرع)"
⎕ "• استغلال أفضل للمعالجات متعددة النوى"
⎕ "• قابلية التوسع مع حجم البيانات"