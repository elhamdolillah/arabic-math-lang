# ═══════════════════════════════════════════════════════════
# مثال: شبكة عصبية متعددة الطبقات
# المرحلة 35 — ﴿فقد استمسك بالعروة الوثقى﴾
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# دالة التنشيط (Step Function)
# ═══════════════════════════════════════════════════════════
تنشيط ≡ λس. س > 0 ؟ 1 : 0

# ═══════════════════════════════════════════════════════════
# الطبقة الأولى: AND
# ═══════════════════════════════════════════════════════════
س ≔ 1
ص ≔ 1

و١ ≔ 1
و٢ ≔ 1
انحياز ≔ 0 - 1

مجموع ≔ و١ · س + و٢ · ص + انحياز
ناتج_and ≔ تنشيط(مجموع)
⎕ "AND(1,1) = " ⊕ نص(ناتج_and)

# ═══════════════════════════════════════════════════════════
# الطبقة الثانية: OR
# ═══════════════════════════════════════════════════════════
انحياز ≔ 0
مجموع ≔ و١ · س + و٢ · ص + انحياز
ناتج_or ≔ تنشيط(مجموع)
⎕ "OR(1,1) = " ⊕ نص(ناتج_or)

# ═══════════════════════════════════════════════════════════
# الطبقة الثالثة: XOR (متعددة الطبقات)
# ═══════════════════════════════════════════════════════════
# XOR = AND(OR(x,y), NAND(x,y))

ناتج_nand ≔ تنشيط(0 - س - ص + 2)
ناتج_xor ≔ تنشيط(ناتج_or + ناتج_nand - 1)
⎕ "XOR(1,1) = " ⊕ نص(ناتج_xor)